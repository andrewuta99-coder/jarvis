import React, { createContext, useContext, useEffect, useState, useCallback } from "react";
import {
  getAccessToken, getRole, setTokens, clearTokens,
} from "../utils/secureTokenStorage";
import { setGlobalAuthErrorHandler } from "../api/client";
import * as AuthService from "../../services/AuthService";

const AuthContext = createContext(null);

export function AuthProvider({ children }) {
  const [user, setUser] = useState(null);
  const [loading, setLoading] = useState(true);

  const refreshMe = useCallback(async () => {
    if (!getAccessToken()) {
      setUser(null);
      setLoading(false);
      return;
    }
    try {
      const me = await AuthService.me();
      setUser({ ...me, role: getRole() });
    } catch {
      clearTokens();
      setUser(null);
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    refreshMe();
    setGlobalAuthErrorHandler(() => {
      clearTokens();
      setUser(null);
      if (window.location.pathname !== "/login") {
        window.location.assign("/login");
      }
    });
    const onExpired = () => {
      setUser(null);
      window.location.assign("/login");
    };
    window.addEventListener("auth:expired", onExpired);
    return () => window.removeEventListener("auth:expired", onExpired);
  }, [refreshMe]);

  const login = useCallback(async ({ email, password, rememberMe = false }) => {
    const tokens = await AuthService.login({ email, password });
    setTokens({
      access: tokens.access_token,
      refresh: tokens.refresh_token,
      role: tokens.role || "member",
      rememberMe,
    });
    await refreshMe();
  }, [refreshMe]);

  const signup = useCallback(async ({ email, password }) => {
    await AuthService.signup({ email, password });
  }, []);

  const verify = useCallback(async ({ email, code }) => {
    const tokens = await AuthService.verify({ email, code });
    setTokens({
      access: tokens.access_token,
      refresh: tokens.refresh_token,
      role: tokens.role || "member",
    });
    await refreshMe();
  }, [refreshMe]);

  const logout = useCallback(async () => {
    try { await AuthService.logout(); } catch { /* ignore */ }
    clearTokens();
    setUser(null);
    window.location.assign("/login");
  }, []);

  return (
    <AuthContext.Provider value={{ user, loading, login, signup, verify, logout, refreshMe }}>
      {children}
    </AuthContext.Provider>
  );
}

export function useAuth() {
  const ctx = useContext(AuthContext);
  if (!ctx) throw new Error("useAuth must be used inside AuthProvider");
  return ctx;
}

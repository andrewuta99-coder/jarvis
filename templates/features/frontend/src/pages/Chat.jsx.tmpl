import React, { useState, useRef, useEffect } from "react";
import { Send } from "lucide-react";
import * as ChatService from "../services/ChatService";
import LoadingButton from "../shared/components/LoadingButton";

/**
 * Streaming chat UI. Pattern lifted from CloudMortgage AgentAssistant.
 * Renders thinking steps + message bubbles. Uses ChatService.streamChat
 * when available, falls back to the synchronous /api/chat otherwise.
 */
export default function Chat() {
  const [threadId, setThreadId] = useState(null);
  const [messages, setMessages] = useState([]);   // {role, content, thinking?}
  const [input, setInput] = useState("");
  const scrollRef = useRef(null);

  useEffect(() => {
    scrollRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [messages]);

  const send = async () => {
    if (!input.trim()) return;
    const userMsg = { role: "user", content: input };
    setMessages(m => [...m, userMsg, { role: "assistant", content: "", thinking: [] }]);
    const message = input;
    setInput("");

    try {
      // Try streaming first
      let buffer = "";
      for await (const event of ChatService.streamChat({ message, threadId })) {
        if (event.thread_id && !threadId) setThreadId(event.thread_id);
        if (event.thinking) {
          setMessages(m => {
            const copy = [...m];
            const last = copy[copy.length - 1];
            last.thinking = [...(last.thinking || []), event.thinking];
            return copy;
          });
        }
        if (event.delta) {
          buffer += event.delta;
          setMessages(m => {
            const copy = [...m];
            copy[copy.length - 1] = { ...copy[copy.length - 1], content: buffer };
            return copy;
          });
        }
      }
    } catch (err) {
      // Fall back to non-streaming
      try {
        const resp = await ChatService.chat({ message, threadId });
        if (!threadId) setThreadId(resp.thread_id);
        setMessages(m => {
          const copy = [...m];
          copy[copy.length - 1] = { role: "assistant", content: resp.response, citations: resp.citations };
          return copy;
        });
      } catch (err2) {
        setMessages(m => {
          const copy = [...m];
          copy[copy.length - 1] = { role: "assistant", content: `Error: ${err2.message}` };
          return copy;
        });
      }
    }
  };

  return (
    <div className="flex flex-col h-[calc(100vh-8rem)]">
      <div className="flex-1 overflow-y-auto space-y-4 pr-2">
        {messages.length === 0 && (
          <div className="text-center text-gray-500 pt-16">
            Ask me anything.
          </div>
        )}
        {messages.map((msg, i) => (
          <div key={i} className={msg.role === "user" ? "flex justify-end" : "flex justify-start"}>
            <div className={`max-w-2xl rounded-lg px-4 py-3 ${
              msg.role === "user"
                ? "bg-primary text-white"
                : "bg-gray-100 dark:bg-gray-900 border border-gray-200 dark:border-gray-800"
            }`}>
              {msg.thinking?.length > 0 && (
                <div className="space-y-1 mb-2 text-xs opacity-70">
                  {msg.thinking.map((step, j) => (
                    <div key={j} className="flex items-center gap-2">
                      <span className="w-2 h-2 rounded-full bg-green-500 inline-block" />
                      {step}
                    </div>
                  ))}
                </div>
              )}
              <div className="whitespace-pre-wrap">{msg.content || (msg.role === "assistant" ? "…" : "")}</div>
              {msg.citations?.length > 0 && (
                <div className="mt-2 pt-2 border-t border-gray-200 dark:border-gray-800 text-xs opacity-70">
                  <div className="font-medium mb-1">Sources:</div>
                  <ul className="space-y-0.5">
                    {msg.citations.map((c, k) => <li key={k}>• {c.source}</li>)}
                  </ul>
                </div>
              )}
            </div>
          </div>
        ))}
        <div ref={scrollRef} />
      </div>

      <form
        onSubmit={(e) => { e.preventDefault(); send(); }}
        className="mt-4 flex gap-2"
      >
        <input
          value={input} onChange={(e) => setInput(e.target.value)}
          placeholder="Type a message…"
          className="flex-1 px-4 py-2 rounded border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900"
        />
        <LoadingButton type="submit" onClick={send} disabled={!input.trim()}>
          <Send size={16} />
        </LoadingButton>
      </form>
    </div>
  );
}

@tailwind base;
@tailwind components;
@tailwind utilities;

/* Brand colors as CSS variables — BrandingContext overrides for multi-tenant. */
:root {
  --color-primary:   0 102 255;   /* #0066ff */
  --color-secondary: 22 22 26;    /* #16161a */
  --color-accent:    255 138 0;   /* #ff8a00 */
}

html, body { height: 100%; }
body { -webkit-font-smoothing: antialiased; }

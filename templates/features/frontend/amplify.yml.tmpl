version: 1
frontend:
  phases:
    preBuild:
      commands:
        - nvm use 20 || nvm install 20
        - npm install --legacy-peer-deps
    build:
      commands:
        # Pattern from CloudMortgage Lender UI — tests must pass before build.
        # If you need a faster iteration loop, set CI=false in Amplify console.
        - npm run test:ci
        - npm run build
  artifacts:
    baseDirectory: build
    files: ["**/*"]
  cache:
    paths:
      - node_modules/**/*
      - ~/.npm/**/*

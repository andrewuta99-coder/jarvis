#!/usr/bin/env bash
# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# Local-dev deploy. CI uses the GitHub Actions workflow.
#
# Same shape as the CloudMortgage deploy.sh — proven flow.

set -e

AWS_REGION="{{REGION}}"
AWS_ACCOUNT_ID="{{ACCOUNT_ID}}"
ECR_REPO="{{APP_NAME}}"
CLUSTER_NAME="{{APP_NAME}}-cluster"
SERVICE_NAME="{{APP_NAME}}-api"
TASK_CPU="${TASK_CPU:-1024}"
TASK_MEMORY="${TASK_MEMORY:-2048}"

GIT_COMMIT=$(git rev-parse --short HEAD)
IMAGE_URI="$AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/$ECR_REPO:$GIT_COMMIT"

echo "==> Login to ECR"
aws ecr get-login-password --region "$AWS_REGION" | \
  docker login --username AWS --password-stdin "$AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com"

echo "==> Build (linux/amd64, $GIT_COMMIT)"
docker build --platform linux/amd64 -t "$ECR_REPO" backend/

echo "==> Push"
docker tag "$ECR_REPO:latest" "$IMAGE_URI"
docker tag "$ECR_REPO:latest" "$AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/$ECR_REPO:latest"
docker push "$IMAGE_URI"
docker push "$AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/$ECR_REPO:latest"

echo "==> Register new task definition"
aws ecs describe-task-definition --task-definition "$SERVICE_NAME" \
  --region "$AWS_REGION" --query 'taskDefinition' > /tmp/td.json
jq --arg IMG "$IMAGE_URI" --arg CPU "$TASK_CPU" --arg MEM "$TASK_MEMORY" \
  'del(.taskDefinitionArn, .revision, .status, .requiresAttributes, .compatibilities, .registeredAt, .registeredBy) | .containerDefinitions[0].image = $IMG | .cpu = $CPU | .memory = $MEM' \
  /tmp/td.json > /tmp/td-new.json
NEW_ARN=$(aws ecs register-task-definition --cli-input-json file:///tmp/td-new.json \
  --region "$AWS_REGION" --query 'taskDefinition.taskDefinitionArn' --output text)
echo "    new task def: $NEW_ARN"

echo "==> Rolling deploy"
aws ecs update-service --cluster "$CLUSTER_NAME" --service "$SERVICE_NAME" \
  --task-definition "$NEW_ARN" --region "$AWS_REGION" --force-new-deployment > /dev/null
aws ecs wait services-stable --cluster "$CLUSTER_NAME" --services "$SERVICE_NAME" --region "$AWS_REGION"

echo "==> Deployed: $GIT_COMMIT"

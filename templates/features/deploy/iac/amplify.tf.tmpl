# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:deploy template:amplify@{{TEMPLATE_HASH}}

variable "region"        { type = string, default = "{{REGION}}" }
variable "app_name"      { type = string, default = "{{APP_NAME}}" }
variable "github_owner"  { type = string, default = "{{GITHUB_OWNER}}" }
variable "github_repo"   { type = string, default = "{{GITHUB_REPO}}" }
variable "github_token"  { type = string, sensitive = true }   # provided via TF_VAR

terraform {
  required_version = ">= 1.5.0"
  required_providers { aws = { source = "hashicorp/aws", version = "~> 5.0" } }
  backend "s3" {
    bucket         = "{{ACCOUNT_ID}}-tf-state-{{REGION}}"
    key            = "deploy/terraform.tfstate"
    region         = "{{REGION}}"
    encrypt        = true
    dynamodb_table = "terraform-state-lock"
  }
}

provider "aws" { region = var.region }

resource "aws_amplify_app" "frontend" {
  name         = "${var.app_name}-frontend"
  repository   = "https://github.com/${var.github_owner}/${var.github_repo}"
  access_token = var.github_token

  build_spec = <<-EOT
    version: 1
    frontend:
      phases:
        preBuild:
          commands:
            - cd frontend
            - npm ci --cache .npm --prefer-offline
        build:
          commands:
            - npm run build
      artifacts:
        baseDirectory: frontend/build
        files: ["**/*"]
      cache:
        paths: ["frontend/.npm/**/*", "frontend/node_modules/**/*"]
  EOT

  enable_branch_auto_build  = true
  enable_branch_auto_deletion = false

  environment_variables = {
    REACT_APP_API_URL = "https://${var.app_name}.jarvis.app"
  }
}

resource "aws_amplify_branch" "main" {
  app_id      = aws_amplify_app.frontend.id
  branch_name = "main"
  stage       = "PRODUCTION"
  enable_auto_build = true
}

output "amplify_app_id"    { value = aws_amplify_app.frontend.id }
output "amplify_branch_url" {
  value = "https://main.${aws_amplify_app.frontend.default_domain}"
}

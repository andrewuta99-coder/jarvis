# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:backend template:ecs_task_definition@{{TEMPLATE_HASH}}

resource "aws_ecs_task_definition" "api" {
  family                   = "${var.app_name}-api"
  network_mode             = "awsvpc"
  requires_compatibilities = ["FARGATE"]
  cpu                      = var.task_cpu
  memory                   = var.task_memory

  execution_role_arn = data.terraform_remote_state.infra.outputs.task_execution_role_arn
  task_role_arn      = data.terraform_remote_state.infra.outputs.task_role_arn

  runtime_platform {
    cpu_architecture        = "X86_64"
    operating_system_family = "LINUX"
  }

  container_definitions = jsonencode([
    {
      name      = "api"
      image     = "${data.terraform_remote_state.infra.outputs.ecr_repo_url}:${var.image_tag}"
      essential = true
      portMappings = [{
        containerPort = 8000
        protocol      = "tcp"
      }]
      environment = [
        { name = "APP_NAME",                value = var.app_name },
        { name = "APP_VERSION",             value = var.image_tag },
        { name = "AWS_REGION",              value = var.region },
        { name = "LOG_LEVEL",               value = "INFO" },
        { name = "MAX_DRAIN_SECONDS",       value = "25" },
        { name = "MAX_TASK_RUNTIME_SECONDS", value = "3600" },
        { name = "CORS_ORIGINS",            value = "https://${var.app_name}.jarvis.app" },
      ]
      logConfiguration = {
        logDriver = "awslogs"
        options = {
          "awslogs-group"         = data.terraform_remote_state.infra.outputs.ecs_log_group_name
          "awslogs-region"        = var.region
          "awslogs-stream-prefix" = "api"
        }
      }
      # SIGTERM drain window — must be >= MAX_DRAIN_SECONDS in signals.py
      stopTimeout = 30
    }
  ])

  tags = local.common_tags
}

# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:backend template:ecs_service@{{TEMPLATE_HASH}}
#
# ECS service on Fargate Spot. 70% cheaper than On-Demand. For workloads
# that can't tolerate Spot interruption, change capacity_provider to FARGATE.

resource "aws_ecs_service" "api" {
  name            = "${var.app_name}-api"
  cluster         = data.terraform_remote_state.infra.outputs.ecs_cluster_arn
  task_definition = aws_ecs_task_definition.api.arn
  desired_count   = var.desired_count

  capacity_provider_strategy {
    capacity_provider = "FARGATE_SPOT"
    weight            = 100
    base              = 0
  }

  deployment_minimum_healthy_percent = 50
  deployment_maximum_percent         = 200

  network_configuration {
    subnets          = data.terraform_remote_state.networking.outputs.private_subnet_ids
    security_groups  = [data.terraform_remote_state.networking.outputs.security_group_app_id]
    assign_public_ip = false
  }

  load_balancer {
    target_group_arn = data.terraform_remote_state.networking.outputs.target_group_app_arn
    container_name   = "api"
    container_port   = 8000
  }

  # ECS waits for ALB to drain before stopping a task — works WITH the
  # SIGTERM handler. ALB deregistration_delay default is 30s.
  lifecycle {
    # Ignore image tag changes from Terraform — the deploy pipeline manages
    # those via register-task-definition. Otherwise every CI deploy would
    # trigger Terraform drift.
    ignore_changes = [task_definition]
  }

  tags = local.common_tags
}

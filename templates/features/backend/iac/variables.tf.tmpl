# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:backend template:iac_variables@{{TEMPLATE_HASH}}

variable "region"      { type = string, default = "{{REGION}}" }
variable "app_name"    { type = string, default = "{{APP_NAME}}" }
variable "account_id"  { type = string, default = "{{ACCOUNT_ID}}" }
variable "environment" { type = string, default = "prod" }

variable "task_cpu"     { type = string, default = "1024" }   # 1 vCPU
variable "task_memory"  { type = string, default = "2048" }   # 2 GB
variable "desired_count" { type = number, default = 1 }

variable "image_tag"   { type = string, default = "latest" }

locals {
  common_tags = {
    Project     = var.app_name
    Environment = var.environment
    ManagedBy   = "Jarvis"
    Feature     = "backend"
  }
}

terraform {
  required_version = ">= 1.5.0"
  required_providers { aws = { source = "hashicorp/aws", version = "~> 5.0" } }
  backend "s3" {
    bucket         = "{{ACCOUNT_ID}}-tf-state-{{REGION}}"
    key            = "ecs/terraform.tfstate"
    region         = "{{REGION}}"
    encrypt        = true
    dynamodb_table = "terraform-state-lock"
  }
}

provider "aws" {
  region = var.region
  default_tags { tags = local.common_tags }
}

# Pull outputs from upstream modules
data "terraform_remote_state" "networking" {
  backend = "s3"
  config = {
    bucket = "${var.account_id}-tf-state-${var.region}"
    key    = "networking/terraform.tfstate"
    region = var.region
  }
}

data "terraform_remote_state" "infra" {
  backend = "s3"
  config = {
    bucket = "${var.account_id}-tf-state-${var.region}"
    key    = "infra/terraform.tfstate"
    region = var.region
  }
}

# Generated by Jarvis v{{JARVIS_VERSION}}. Safe to edit.
# Ruff config — replaces black + isort + flake8 + bandit's lint surface.

[tool.ruff]
line-length = 100
target-version = "py311"

[tool.ruff.lint]
select = [
    "E",    # pycodestyle errors
    "W",    # pycodestyle warnings
    "F",    # pyflakes
    "I",    # isort
    "B",    # bugbear
    "S",    # bandit (security)
    "UP",   # pyupgrade
    "RUF",  # ruff-specific
]
ignore = [
    "S101",  # assert use is fine in tests
    "B008",  # FastAPI's Depends() trips this
]

[tool.ruff.lint.per-file-ignores]
"tests/*" = ["S105", "S106"]   # hardcoded test strings/passwords are fine

[tool.mypy]
python_version = "3.11"
warn_unused_ignores = true
warn_redundant_casts = true
ignore_missing_imports = true

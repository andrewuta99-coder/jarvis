"""
Secrets Manager client. Loads all jarvis/{app}/* secrets on startup, caches them.

DO NOT fetch secrets per-request — the latency adds up and you'll hit rate
limits. Load once at startup; rotate via app restart or explicit refresh.
"""
from __future__ import annotations

import json
import logging
import os
from typing import Any

import boto3

logger = logging.getLogger(__name__)

APP_NAME = os.environ.get("APP_NAME", "{{APP_NAME}}")
REGION = os.environ.get("AWS_REGION", "{{REGION}}")
SECRET_PREFIX = f"jarvis/{APP_NAME}/"

_cache: dict[str, Any] = {}
_loaded = False


async def load_secrets() -> None:
    """Called once at app startup (from lifespan handler)."""
    global _loaded
    if _loaded:
        return

    client = boto3.client("secretsmanager", region_name=REGION)
    paginator = client.get_paginator("list_secrets")

    for page in paginator.paginate(
        Filters=[{"Key": "name", "Values": [SECRET_PREFIX]}]
    ):
        for entry in page.get("SecretList", []):
            name = entry["Name"]
            try:
                resp = client.get_secret_value(SecretId=name)
                raw = resp.get("SecretString")
                if raw is None:
                    continue
                try:
                    _cache[name] = json.loads(raw)
                except json.JSONDecodeError:
                    _cache[name] = raw
                logger.info("secret_loaded", extra={"name": name})
            except Exception as exc:
                logger.error("secret_load_failed", extra={"name": name, "error": str(exc)})

    _loaded = True


def get(name: str, default: Any = None) -> Any:
    """Get a cached secret. Full name (with jarvis/{app}/ prefix) or short name."""
    if name in _cache:
        return _cache[name]
    full = f"{SECRET_PREFIX}{name}" if not name.startswith(SECRET_PREFIX) else name
    return _cache.get(full, default)

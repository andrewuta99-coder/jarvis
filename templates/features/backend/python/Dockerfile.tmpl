# Multi-stage Dockerfile for FastAPI on ECS Fargate (Spot).
# Build for linux/amd64 — ECS runs Linux, ARM Macs need explicit --platform.

FROM python:3.11-slim AS builder

WORKDIR /build
COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt


FROM python:3.11-slim

WORKDIR /app

# Non-root user — defense in depth.
RUN useradd -m -u 1000 app && chown -R app:app /app

COPY --from=builder /install /usr/local
COPY --chown=app:app . .

USER app

EXPOSE 8000

# Uvicorn directly — single process, signals propagate cleanly.
# ECS gives us the workers via replica count, not uvicorn workers.
# Important for the SIGTERM handler in core/signals.py to fire correctly.
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--log-config", "core/uvicorn_log_config.json"]

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8000/api/health', timeout=3).status == 200 else 1)"

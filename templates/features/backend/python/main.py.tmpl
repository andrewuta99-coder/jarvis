from __future__ import annotations

import logging
import os
import time
import uuid
from contextlib import asynccontextmanager

from fastapi import FastAPI, Request
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import JSONResponse

from core.logging_config import configure_logging
from core.signals import install_signal_handlers
from core.secrets import load_secrets
from core.errors import AppError

configure_logging()
logger = logging.getLogger(__name__)

VERSION = os.environ.get("APP_VERSION", "dev")
ALLOWED_ORIGINS = [o.strip() for o in os.environ.get("CORS_ORIGINS", "").split(",") if o.strip()]


@asynccontextmanager
async def lifespan(app: FastAPI):
    """Startup + shutdown handlers."""
    logger.info("startup_begin", extra={"version": VERSION})
    install_signal_handlers()
    # Cache secrets at startup — not per-request.
    await load_secrets()
    logger.info("startup_complete")
    yield
    logger.info("shutdown_complete")


app = FastAPI(
    title="{{APP_NAME}}",
    version=VERSION,
    lifespan=lifespan,
)

app.add_middleware(
    CORSMiddleware,
    allow_origins=ALLOWED_ORIGINS or ["http://localhost:3000"],
    allow_credentials=True,
    allow_methods=["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
    allow_headers=["*"],
)


@app.middleware("http")
async def request_id_and_timing(request: Request, call_next):
    """Attach request_id, log request shape + duration."""
    rid = request.headers.get("x-request-id") or str(uuid.uuid4())
    request.state.request_id = rid
    start = time.perf_counter()
    response = await call_next(request)
    duration_ms = (time.perf_counter() - start) * 1000
    logger.info(
        "request",
        extra={
            "request_id": rid,
            "method": request.method,
            "path": request.url.path,
            "status": response.status_code,
            "duration_ms": round(duration_ms, 1),
        },
    )
    response.headers["x-request-id"] = rid
    return response


@app.exception_handler(AppError)
async def app_error_handler(request: Request, exc: AppError):
    """Single-shape error envelope across the API."""
    return JSONResponse(
        status_code=exc.status_code,
        content={
            "error": {
                "code": exc.code,
                "message": exc.message,
                "details": exc.details,
            }
        },
    )


@app.get("/api/health")
async def health():
    """ALB target group health check hits this. Returns 200 if the process
    is up and can read its environment. Add a DB ping if you want a deeper
    check — keep it under 2s or the ALB will mark unhealthy."""
    return {"status": "ok", "version": VERSION}



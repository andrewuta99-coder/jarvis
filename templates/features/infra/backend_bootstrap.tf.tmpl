# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:infra template:backend_bootstrap@{{TEMPLATE_HASH}}
#
# Chicken-and-egg: this module's own backend.tf references the very S3 bucket
# and DynamoDB lock table it provisions. Bootstrap flow:
#   1. Apply this module ONCE with `terraform { backend "local" {} }` to create
#      the bucket and lock table.
#   2. Migrate state: re-init with the S3 backend block (in variables.tf),
#      Terraform copies the local state into S3.
#   3. All subsequent modules use the S3 backend from day one.
#
# The Ship agent handles this bootstrap automatically on first apply.

resource "aws_s3_bucket" "tf_state" {
  bucket = "${var.account_id}-tf-state-${var.region}"

  lifecycle {
    prevent_destroy = true   # losing state = losing track of what's deployed
  }

  tags = local.common_tags
}

resource "aws_s3_bucket_versioning" "tf_state" {
  bucket = aws_s3_bucket.tf_state.id
  versioning_configuration {
    status = "Enabled"
  }
}

resource "aws_s3_bucket_server_side_encryption_configuration" "tf_state" {
  bucket = aws_s3_bucket.tf_state.id
  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256"
    }
  }
}

resource "aws_s3_bucket_public_access_block" "tf_state" {
  bucket                  = aws_s3_bucket.tf_state.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_dynamodb_table" "tf_lock" {
  name         = "terraform-state-lock"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "LockID"

  attribute {
    name = "LockID"
    type = "S"
  }

  lifecycle {
    prevent_destroy = true
  }

  tags = local.common_tags
}

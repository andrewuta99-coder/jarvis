# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:infra template:ecs_cluster@{{TEMPLATE_HASH}}
#
# Fargate Spot by default — 70% cheaper than On-Demand. Production workloads
# that need stable capacity can opt back into On-Demand per-service.

resource "aws_ecs_cluster" "main" {
  name = "${var.app_name}-cluster"

  setting {
    name  = "containerInsights"
    value = "enabled"
  }

  tags = local.common_tags
}

resource "aws_ecs_cluster_capacity_providers" "main" {
  cluster_name = aws_ecs_cluster.main.name

  capacity_providers = ["FARGATE_SPOT", "FARGATE"]

  default_capacity_provider_strategy {
    capacity_provider = "FARGATE_SPOT"
    weight            = 100
    base              = 0
  }
}

# CloudWatch log group for ECS task logs (default for all services in this cluster)
resource "aws_cloudwatch_log_group" "ecs" {
  name              = "/ecs/${var.app_name}"
  retention_in_days = 7

  tags = local.common_tags
}

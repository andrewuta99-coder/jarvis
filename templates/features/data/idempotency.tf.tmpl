# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:data table:idempotency template:idempotency@{{TEMPLATE_HASH}}
#
# The 2026-01-11 CloudMortgage double-charge fix.
# Every credit-charging endpoint MUST check this table before processing,
# and write a PENDING marker before calling Stripe. 24h TTL on records.

resource "aws_dynamodb_table" "idempotency" {
  name         = "${var.app_name}-idempotency"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "request_id"

  attribute { name = "request_id" type = "S" }

  ttl {
    attribute_name = "ttl"
    enabled        = true
  }

  # 24h is enough for any reasonable retry window. Records auto-expire.
  point_in_time_recovery { enabled = true }
  deletion_protection_enabled = true
  server_side_encryption { enabled = true }

  lifecycle {
    prevent_destroy = true
    ignore_changes  = [attribute, global_secondary_index]
  }

  tags = merge(local.common_tags, { Table = "idempotency" })
}

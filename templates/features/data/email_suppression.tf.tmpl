# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:data table:email_suppression template:email_suppression@{{TEMPLATE_HASH}}
#
# SES bounce + complaint Lambda writes here. send_email() helper queries
# before every send. Prevents re-sending to known-bouncing addresses (which
# damages your sender reputation and can get you sandboxed back to the start).

resource "aws_dynamodb_table" "email_suppression" {
  name         = "${var.app_name}-email-suppression"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "email"

  attribute { name = "email"  type = "S" }
  attribute { name = "reason" type = "S" }

  global_secondary_index {
    name            = "reason-index"
    hash_key        = "reason"   # bounce | complaint | manual
    projection_type = "ALL"
  }

  point_in_time_recovery { enabled = true }
  deletion_protection_enabled = true
  server_side_encryption { enabled = true }

  lifecycle {
    prevent_destroy = true
    ignore_changes  = [attribute, global_secondary_index]
  }

  tags = merge(local.common_tags, { Table = "email-suppression" })
}

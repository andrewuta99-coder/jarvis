#
# The CloudMortgage 2026-01-28 hardening: codes hashed with HMAC-SHA256,
# constant-time compare on verify, per-tenant rate limit. Backend code in
# features/auth implements the protocol; this table stores the records.

resource "aws_dynamodb_table" "signup_codes" {
  name         = "${var.app_name}-signup-codes"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "email"           # normalized
  range_key    = "record_type"     # CODE | VERIFIED | RATE_LIMIT

  attribute { name = "email"       type = "S" }
  attribute { name = "record_type" type = "S" }

  ttl {
    attribute_name = "ttl"
    enabled        = true
  }

  point_in_time_recovery { enabled = true }
  deletion_protection_enabled = true
  server_side_encryption { enabled = true }

  lifecycle {
    prevent_destroy = true
    ignore_changes  = [attribute, global_secondary_index]
  }

  tags = merge(local.common_tags, { Table = "signup-codes" })
}

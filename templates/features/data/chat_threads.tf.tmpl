resource "aws_dynamodb_table" "chat_threads" {
  name         = "${var.app_name}-chat-threads"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "userId"
  range_key    = "thread_id"

  attribute { name = "userId"    type = "S" }
  attribute { name = "thread_id" type = "S" }
  attribute { name = "updated_at" type = "N" }

  global_secondary_index {
    name            = "userId-updated_at-index"
    hash_key        = "userId"
    range_key       = "updated_at"
    projection_type = "ALL"
  }

  point_in_time_recovery { enabled = true }
  deletion_protection_enabled = true
  server_side_encryption { enabled = true }

  lifecycle {
    prevent_destroy = true
    ignore_changes  = [attribute, global_secondary_index]
  }

  tags = merge(local.common_tags, { Table = "chat-threads" })
}

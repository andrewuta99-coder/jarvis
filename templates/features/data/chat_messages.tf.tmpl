# feature:data table:chat_messages template:chat_messages@{{TEMPLATE_HASH}}

resource "aws_dynamodb_table" "chat_messages" {
  name         = "${var.app_name}-chat-messages"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "thread_id"
  range_key    = "created_at"

  attribute { name = "thread_id"  type = "S" }
  attribute { name = "created_at" type = "N" }

  point_in_time_recovery { enabled = true }
  deletion_protection_enabled = true
  server_side_encryption { enabled = true }

  lifecycle {
    prevent_destroy = true
    ignore_changes  = [attribute, global_secondary_index]
  }

  tags = merge(local.common_tags, { Table = "chat-messages" })
}

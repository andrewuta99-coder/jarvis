# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:payments template:secrets@{{TEMPLATE_HASH}}

variable "region"     { type = string, default = "{{REGION}}" }
variable "app_name"   { type = string, default = "{{APP_NAME}}" }
variable "account_id" { type = string, default = "{{ACCOUNT_ID}}" }

terraform {
  required_version = ">= 1.5.0"
  required_providers { aws = { source = "hashicorp/aws", version = "~> 5.0" } }
  backend "s3" {
    bucket         = "{{ACCOUNT_ID}}-tf-state-{{REGION}}"
    key            = "payments/terraform.tfstate"
    region         = "{{REGION}}"
    encrypt        = true
    dynamodb_table = "terraform-state-lock"
  }
}

provider "aws" { region = var.region }

# Stripe secret holds: publishable_key, secret_key, webhook_secret
# Initial value is a placeholder — user updates via aws secretsmanager
# update-secret AFTER /jarvis-add-payments asks for keys interactively.
resource "aws_secretsmanager_secret" "stripe" {
  name                    = "jarvis/${var.app_name}/stripe"
  description             = "Stripe keys: publishable, secret, webhook"
  recovery_window_in_days = 7
}

resource "aws_secretsmanager_secret_version" "stripe_initial" {
  secret_id = aws_secretsmanager_secret.stripe.id
  secret_string = jsonencode({
    publishable_key = "pk_test_PLACEHOLDER"
    secret_key      = "sk_test_PLACEHOLDER"
    webhook_secret  = "whsec_PLACEHOLDER"
  })

  lifecycle {
    # User overwrites this with real keys. Terraform must NOT revert.
    ignore_changes = [secret_string]
  }
}

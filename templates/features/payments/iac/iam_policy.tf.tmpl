# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:payments template:iam_policy@{{TEMPLATE_HASH}}

resource "aws_iam_role_policy" "payments_task" {
  name = "${var.app_name}-payments-task"
  role = "{{TASK_ROLE_NAME}}"

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid    = "PaymentsTables"
        Effect = "Allow"
        Action = [
          "dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem",
          "dynamodb:DeleteItem", "dynamodb:Query",
        ]
        Resource = [
          "arn:aws:dynamodb:${var.region}:${var.account_id}:table/${var.app_name}-customers",
          "arn:aws:dynamodb:${var.region}:${var.account_id}:table/${var.app_name}-customers/index/*",
          "arn:aws:dynamodb:${var.region}:${var.account_id}:table/${var.app_name}-subscriptions",
          "arn:aws:dynamodb:${var.region}:${var.account_id}:table/${var.app_name}-subscriptions/index/*",
          "arn:aws:dynamodb:${var.region}:${var.account_id}:table/${var.app_name}-idempotency",
        ]
      },
      {
        Sid    = "StripeSecret"
        Effect = "Allow"
        Action = ["secretsmanager:GetSecretValue"]
        Resource = "arn:aws:secretsmanager:${var.region}:${var.account_id}:secret:jarvis/${var.app_name}/stripe-*"
      }
    ]
  })
}

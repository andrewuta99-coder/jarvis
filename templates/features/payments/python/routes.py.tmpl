"""Payments routes — wire under /api/payments."""
from __future__ import annotations

from typing import Annotated

from fastapi import APIRouter, Depends, Header, Request, status
from pydantic import BaseModel

from core.auth_middleware import AuthUser, require_user
from core.errors import BadRequest

from . import service, webhook_handler
from .idempotency import idempotency

router = APIRouter()


class CheckoutBody(BaseModel):
    tier: str   # "free" | "pro" | "business"


@router.post("/checkout")
@idempotency(ttl_seconds=3600)
async def checkout(body: CheckoutBody, user: Annotated[AuthUser, Depends(require_user)]):
    return await service.create_checkout_session(user=user, tier=body.tier)


@router.post("/webhook", status_code=status.HTTP_200_OK)
async def webhook(request: Request, stripe_signature: Annotated[str | None, Header()] = None):
    if not stripe_signature:
        raise BadRequest("Missing Stripe signature")
    body = await request.body()
    return await webhook_handler.handle(body=body, signature=stripe_signature)


@router.get("/portal")
async def portal(user: Annotated[AuthUser, Depends(require_user)]):
    return await service.customer_portal_url(user=user)


@router.get("/subscriptions")
async def subscriptions(user: Annotated[AuthUser, Depends(require_user)]):
    return await service.user_subscriptions(user_id=user.user_id)


@router.post("/cancel", status_code=status.HTTP_204_NO_CONTENT)
async def cancel(user: Annotated[AuthUser, Depends(require_user)]):
    await service.cancel_subscription(user=user)

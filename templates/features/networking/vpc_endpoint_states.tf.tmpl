# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:networking template:vpc_endpoint_states@{{TEMPLATE_HASH}}
#
# Step Functions VPC endpoint — required when the `jobs` feature uses SFN.
# The 2026-01-11 CloudMortgage incident (Step Functions execution silently
# failed because tasks couldn't reach states.us-east-1.amazonaws.com from
# private subnets) is permanently fixed by this endpoint.

resource "aws_vpc_endpoint" "states" {
  vpc_id              = aws_vpc.main.id
  service_name        = "com.amazonaws.${var.region}.states"
  vpc_endpoint_type   = "Interface"
  subnet_ids          = aws_subnet.private[*].id
  security_group_ids  = [aws_security_group.vpce.id]
  private_dns_enabled = true

  tags = merge(local.common_tags, { Name = "${var.app_name}-vpce-states" })
}

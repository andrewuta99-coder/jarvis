# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:networking template:vpc@{{TEMPLATE_HASH}}

resource "aws_vpc" "main" {
  cidr_block           = var.cidr_block
  enable_dns_support   = true
  enable_dns_hostnames = true   # required for VPC endpoint private DNS

  tags = merge(local.common_tags, {
    Name = "${var.app_name}-vpc"
  })
}

# No internet gateway on the app side — only the public subnets used by the ALB
# get one. Private subnets stay private. VPC endpoints provide AWS API access.
resource "aws_internet_gateway" "main" {
  vpc_id = aws_vpc.main.id

  tags = merge(local.common_tags, {
    Name = "${var.app_name}-igw"
  })
}

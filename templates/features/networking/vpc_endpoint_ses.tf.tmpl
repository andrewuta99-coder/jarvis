# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:networking template:vpc_endpoint_ses@{{TEMPLATE_HASH}}
#
# THE invisible rail. The 2026-12-22 CloudMortgage incident — "Connect timeout
# on email.us-east-1.amazonaws.com" from private subnet tasks — is permanently
# fixed by this endpoint. Without it, your SES emails silently never send.
#
# Cost: ~$7.30/mo (2 AZs × $0.01/hr).

resource "aws_vpc_endpoint" "ses" {
  vpc_id              = aws_vpc.main.id
  service_name        = "com.amazonaws.${var.region}.email"
  vpc_endpoint_type   = "Interface"
  subnet_ids          = aws_subnet.private[*].id
  security_group_ids  = [aws_security_group.vpce.id]
  private_dns_enabled = true

  tags = merge(local.common_tags, {
    Name    = "${var.app_name}-vpce-ses"
    Purpose = "Prevents the 2026-12-22 SES connect-timeout incident class"
  })
}

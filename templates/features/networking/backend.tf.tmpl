# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:networking template:backend@{{TEMPLATE_HASH}}

terraform {
  required_version = ">= 1.5.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }

  # State managed via S3 + DynamoDB lock table provisioned by the infra module.
  # Bootstrap order: infra/backend creates the state bucket + lock table BEFORE
  # any module uses remote state. Re-init this module after bootstrap.
  backend "s3" {
    bucket         = "{{ACCOUNT_ID}}-tf-state-{{REGION}}"
    key            = "networking/terraform.tfstate"
    region         = "{{REGION}}"
    encrypt        = true
    dynamodb_table = "terraform-state-lock"
  }
}

provider "aws" {
  region = var.region

  default_tags {
    tags = local.common_tags
  }
}

data "aws_availability_zones" "available" {
  state = "available"
}

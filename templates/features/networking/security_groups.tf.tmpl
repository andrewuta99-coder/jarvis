# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:networking template:security_groups@{{TEMPLATE_HASH}}
#
# Three security groups in a chain:
#   ALB SG   <- internet (443, 80-redirect)
#   App SG   <- ALB SG only (8000)
#   VPCe SG  <- App SG only (443) — for interface VPC endpoints

resource "aws_security_group" "alb" {
  name        = "${var.app_name}-alb-sg"
  description = "ALB ingress from the internet on 443/80"
  vpc_id      = aws_vpc.main.id

  ingress {
    description = "HTTPS from internet"
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "HTTP for redirect-to-HTTPS"
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    description = "All outbound (to app SG)"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = merge(local.common_tags, { Name = "${var.app_name}-alb-sg" })
}

resource "aws_security_group" "app" {
  name        = "${var.app_name}-app-sg"
  description = "App tasks — ingress from ALB only"
  vpc_id      = aws_vpc.main.id

  ingress {
    description     = "App port from ALB"
    from_port       = 8000
    to_port         = 8000
    protocol        = "tcp"
    security_groups = [aws_security_group.alb.id]
  }

  egress {
    description = "All outbound (VPC endpoints, internet via igw only via public subnets)"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = merge(local.common_tags, { Name = "${var.app_name}-app-sg" })
}

resource "aws_security_group" "vpce" {
  name        = "${var.app_name}-vpce-sg"
  description = "Interface VPC endpoints — ingress from app SG only on 443"
  vpc_id      = aws_vpc.main.id

  ingress {
    description     = "HTTPS from app SG"
    from_port       = 443
    to_port         = 443
    protocol        = "tcp"
    security_groups = [aws_security_group.app.id]
  }

  tags = merge(local.common_tags, { Name = "${var.app_name}-vpce-sg" })
}

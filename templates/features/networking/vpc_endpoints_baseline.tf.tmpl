# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:networking template:vpc_endpoints_baseline@{{TEMPLATE_HASH}}
#
# Interface VPC endpoints — ALWAYS-ON SET.
# These are the AWS services every ECS task needs to reach from private subnets.
# Without these: silent connection timeouts (the 2026-12-27 incident class).
#
# Cost: $0.01/hr per endpoint per AZ. With 3 AZs and 7 endpoints = ~$153/mo.
# Trade is worth it: NAT Gateway would cost $0.045/hr/AZ + data transfer.

locals {
  baseline_interface_endpoints = [
    "logs",            # CloudWatch Logs ingestion
    "sts",             # IAM identity (every AWS SDK call uses this)
    "secretsmanager",  # Secrets fetched at app startup
    "ecr.api",         # Image pull metadata
    "ecr.dkr",         # Image layer pull
  ]
}

resource "aws_vpc_endpoint" "interface_baseline" {
  for_each = toset(local.baseline_interface_endpoints)

  vpc_id              = aws_vpc.main.id
  service_name        = "com.amazonaws.${var.region}.${each.key}"
  vpc_endpoint_type   = "Interface"
  subnet_ids          = aws_subnet.private[*].id
  security_group_ids  = [aws_security_group.vpce.id]
  private_dns_enabled = true

  tags = merge(local.common_tags, {
    Name = "${var.app_name}-vpce-${replace(each.key, ".", "-")}"
  })
}

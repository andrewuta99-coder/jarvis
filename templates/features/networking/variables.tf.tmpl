# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:networking template:variables@{{TEMPLATE_HASH}}
# Safe to edit. Jarvis detects edits and never overwrites on /jarvis-upgrade.

variable "region" {
  description = "AWS region for this stack"
  type        = string
  default     = "{{REGION}}"
}

variable "app_name" {
  description = "Short app slug used in resource naming"
  type        = string
  default     = "{{APP_NAME}}"
}

variable "account_id" {
  description = "AWS account ID — for IAM ARN construction"
  type        = string
  default     = "{{ACCOUNT_ID}}"
}

variable "environment" {
  description = "prod | staging | dev"
  type        = string
  default     = "prod"
}

variable "cidr_block" {
  description = "VPC CIDR block"
  type        = string
  default     = "10.0.0.0/16"
}

variable "az_count" {
  description = "Number of AZs to spread subnets across"
  type        = number
  default     = 3
}

locals {
  common_tags = {
    Project     = var.app_name
    Environment = var.environment
    ManagedBy   = "Jarvis"
    Feature     = "networking"
  }
}

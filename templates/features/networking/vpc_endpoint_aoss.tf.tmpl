# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:networking template:vpc_endpoint_aoss@{{TEMPLATE_HASH}}
#
# OpenSearch Serverless VPC endpoint — required for KB queries from private
# subnets. Pairs with the aoss:BatchGetCollection IAM grant on the ECS task role
# (in features/ai/iam_task_policy.tf). Without both, the AI feature's "Starting
# up AI knowledge base..." loading state never resolves.

resource "aws_vpc_endpoint" "aoss" {
  vpc_id              = aws_vpc.main.id
  service_name        = "com.amazonaws.${var.region}.aoss"
  vpc_endpoint_type   = "Interface"
  subnet_ids          = aws_subnet.private[*].id
  security_group_ids  = [aws_security_group.vpce.id]
  private_dns_enabled = true

  tags = merge(local.common_tags, {
    Name    = "${var.app_name}-vpce-aoss"
    Purpose = "OpenSearch Serverless from private subnets; fixes 2026-01-16 KB init bug"
  })
}

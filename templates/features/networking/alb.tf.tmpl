# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:networking template:alb@{{TEMPLATE_HASH}}
#
# ALB with HTTPS listener (443) and HTTP-to-HTTPS redirect on 80.
# The CloudMortgage 2026-01-16 incident (missing HTTPS listener + missing SG
# rule + cert) is permanently fixed: all three present here from day one.

resource "aws_lb" "main" {
  name               = "${var.app_name}-alb"
  internal           = false
  load_balancer_type = "application"
  security_groups    = [aws_security_group.alb.id]
  subnets            = aws_subnet.public[*].id

  enable_deletion_protection = var.environment == "prod" ? true : false
  idle_timeout               = 60

  tags = local.common_tags
}

resource "aws_lb_target_group" "app" {
  name        = "${var.app_name}-app-tg"
  port        = 8000
  protocol    = "HTTP"
  vpc_id      = aws_vpc.main.id
  target_type = "ip"

  health_check {
    enabled             = true
    healthy_threshold   = 2
    interval            = 30
    matcher             = "200"
    path                = "/api/health"
    port                = "traffic-port"
    protocol            = "HTTP"
    timeout             = 5
    unhealthy_threshold = 3
  }

  deregistration_delay = 30   # SIGTERM drain window — matches backend signal handler

  tags = local.common_tags
}

# ─── ACM certificate (DNS-validated by default) ──────────────
# At v0 we generate a placeholder cert. /jarvis-add-domain handles real domains.
# This cert covers a jarvis.app subdomain only — if user adds custom domain
# later, that skill regenerates the cert for the new domain.
resource "aws_acm_certificate" "alb" {
  domain_name       = "${var.app_name}-jarvis.app"
  validation_method = "DNS"

  lifecycle {
    create_before_destroy = true
  }

  tags = local.common_tags
}

resource "aws_lb_listener" "https" {
  load_balancer_arn = aws_lb.main.arn
  port              = "443"
  protocol          = "HTTPS"
  ssl_policy        = "ELBSecurityPolicy-TLS13-1-2-2021-06"
  certificate_arn   = aws_acm_certificate.alb.arn

  default_action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.app.arn
  }
}

resource "aws_lb_listener" "http_redirect" {
  load_balancer_arn = aws_lb.main.arn
  port              = "80"
  protocol          = "HTTP"

  default_action {
    type = "redirect"

    redirect {
      port        = "443"
      protocol    = "HTTPS"
      status_code = "HTTP_301"
    }
  }
}

# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:networking template:vpc_endpoints_gateway@{{TEMPLATE_HASH}}
#
# Gateway VPC endpoints — FREE (no hourly charge).
# These intercept S3 and DynamoDB traffic from private subnets, avoiding NAT.

resource "aws_vpc_endpoint" "s3" {
  vpc_id            = aws_vpc.main.id
  service_name      = "com.amazonaws.${var.region}.s3"
  vpc_endpoint_type = "Gateway"
  route_table_ids   = [aws_route_table.private.id]

  tags = merge(local.common_tags, { Name = "${var.app_name}-vpce-s3" })
}

resource "aws_vpc_endpoint" "dynamodb" {
  vpc_id            = aws_vpc.main.id
  service_name      = "com.amazonaws.${var.region}.dynamodb"
  vpc_endpoint_type = "Gateway"
  route_table_ids   = [aws_route_table.private.id]

  tags = merge(local.common_tags, { Name = "${var.app_name}-vpce-dynamodb" })
}

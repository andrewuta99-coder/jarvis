# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:networking template:subnets@{{TEMPLATE_HASH}}
#
# 3 private subnets (app workloads) + 2 public subnets (ALB only).
# Private subnets have NO route to the internet — VPC endpoints handle AWS APIs.
# This saves $32/mo/AZ vs the standard NAT Gateway pattern.

locals {
  az_names = slice(data.aws_availability_zones.available.names, 0, var.az_count)
}

# ─── Private subnets (app) ────────────────────────────────────
resource "aws_subnet" "private" {
  count             = var.az_count
  vpc_id            = aws_vpc.main.id
  cidr_block        = cidrsubnet(var.cidr_block, 8, count.index)
  availability_zone = local.az_names[count.index]

  tags = merge(local.common_tags, {
    Name = "${var.app_name}-private-${local.az_names[count.index]}"
    Tier = "private"
  })
}

resource "aws_route_table" "private" {
  vpc_id = aws_vpc.main.id

  tags = merge(local.common_tags, {
    Name = "${var.app_name}-private-rt"
  })
}

resource "aws_route_table_association" "private" {
  count          = var.az_count
  subnet_id      = aws_subnet.private[count.index].id
  route_table_id = aws_route_table.private.id
}

# ─── Public subnets (ALB only) ────────────────────────────────
resource "aws_subnet" "public" {
  count                   = 2  # ALB only needs 2 AZs minimum
  vpc_id                  = aws_vpc.main.id
  cidr_block              = cidrsubnet(var.cidr_block, 8, count.index + 100)
  availability_zone       = local.az_names[count.index]
  map_public_ip_on_launch = false  # ALB has its own EIP, no instance-level public IPs

  tags = merge(local.common_tags, {
    Name = "${var.app_name}-public-${local.az_names[count.index]}"
    Tier = "public"
  })
}

resource "aws_route_table" "public" {
  vpc_id = aws_vpc.main.id

  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.main.id
  }

  tags = merge(local.common_tags, {
    Name = "${var.app_name}-public-rt"
  })
}

resource "aws_route_table_association" "public" {
  count          = length(aws_subnet.public)
  subnet_id      = aws_subnet.public[count.index].id
  route_table_id = aws_route_table.public.id
}

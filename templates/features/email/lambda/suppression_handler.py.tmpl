"""SES bounce/complaint handler — writes affected addresses to the
suppression table so we stop emailing them.

Subscribed to the SES configuration set's SNS topic.
"""
from __future__ import annotations

import json
import logging
import os
import time

import boto3

logger = logging.getLogger()
logger.setLevel(logging.INFO)

TABLE = os.environ["SUPPRESSION_TABLE"]
ddb = boto3.resource("dynamodb").Table(TABLE)


def lambda_handler(event, _context):
    """Each record from SNS contains a single SES event. Parse and write."""
    for record in event.get("Records", []):
        try:
            msg = json.loads(record["Sns"]["Message"])
            event_type = msg.get("eventType") or msg.get("notificationType")
            ts = int(time.time())

            if event_type == "Bounce":
                for recip in msg["bounce"]["bouncedRecipients"]:
                    _suppress(recip["emailAddress"].lower(), reason="bounce", ts=ts,
                              detail=msg["bounce"].get("bounceType"))
            elif event_type == "Complaint":
                for recip in msg["complaint"]["complainedRecipients"]:
                    _suppress(recip["emailAddress"].lower(), reason="complaint", ts=ts,
                              detail=msg["complaint"].get("complaintFeedbackType"))
            else:
                logger.info("ignored_event", extra={"event_type": event_type})
        except Exception as exc:
            logger.error("processing_failed", extra={"error": str(exc)})


def _suppress(email: str, *, reason: str, ts: int, detail: str | None) -> None:
    ddb.put_item(Item={
        "email": email,
        "reason": reason,
        "detail": detail or "",
        "suppressed_at": ts,
    })
    logger.info("suppressed", extra={"email_hash": hash(email), "reason": reason})

# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:email template:sns_topics@{{TEMPLATE_HASH}}

resource "aws_sns_topic" "bounces" {
  name = "${var.app_name}-email-events"
}

resource "aws_sns_topic_subscription" "bounce_to_lambda" {
  topic_arn = aws_sns_topic.bounces.arn
  protocol  = "lambda"
  endpoint  = aws_lambda_function.suppression.arn
}

resource "aws_lambda_permission" "sns_invoke" {
  statement_id  = "AllowSNSInvoke"
  action        = "lambda:InvokeFunction"
  function_name = aws_lambda_function.suppression.function_name
  principal     = "sns.amazonaws.com"
  source_arn    = aws_sns_topic.bounces.arn
}

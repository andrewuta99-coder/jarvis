# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:email template:ses@{{TEMPLATE_HASH}}

variable "region"      { type = string, default = "{{REGION}}" }
variable "app_name"    { type = string, default = "{{APP_NAME}}" }
variable "account_id"  { type = string, default = "{{ACCOUNT_ID}}" }
variable "domain"      { type = string, default = "{{DOMAIN}}" }

terraform {
  required_version = ">= 1.5.0"
  required_providers { aws = { source = "hashicorp/aws", version = "~> 5.0" } }
  backend "s3" {
    bucket         = "{{ACCOUNT_ID}}-tf-state-{{REGION}}"
    key            = "email/terraform.tfstate"
    region         = "{{REGION}}"
    encrypt        = true
    dynamodb_table = "terraform-state-lock"
  }
}

provider "aws" { region = var.region }

# Domain identity (with DKIM)
resource "aws_sesv2_email_identity" "domain" {
  email_identity = var.domain

  dkim_signing_attributes {
    next_signing_key_length = "RSA_2048_BIT"
  }
}

resource "aws_sesv2_email_identity" "sender" {
  email_identity = "noreply@${var.domain}"
}

resource "aws_sesv2_configuration_set" "main" {
  configuration_set_name = "${var.app_name}-config-set"

  delivery_options {
    tls_policy = "REQUIRE"
  }

  reputation_options {
    reputation_metrics_enabled = true
  }

  sending_options {
    sending_enabled = true
  }
}

# Event publishing — sends bounce + complaint events to SNS
resource "aws_sesv2_configuration_set_event_destination" "sns" {
  configuration_set_name = aws_sesv2_configuration_set.main.configuration_set_name
  event_destination_name = "${var.app_name}-events"

  event_destination {
    enabled = true
    matching_event_types = ["BOUNCE", "COMPLAINT", "REJECT", "DELIVERY_DELAY"]

    sns_destination {
      topic_arn = aws_sns_topic.bounces.arn
    }
  }
}

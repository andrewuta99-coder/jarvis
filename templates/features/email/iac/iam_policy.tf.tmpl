# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:email template:iam_policy@{{TEMPLATE_HASH}}

resource "aws_iam_role_policy" "email_task" {
  name = "${var.app_name}-email-task"
  role = "{{TASK_ROLE_NAME}}"

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid    = "SendEmail"
        Effect = "Allow"
        Action = [
          "ses:SendEmail",
          "ses:SendRawEmail",
          "sesv2:SendEmail",
        ]
        Resource = "*"
        Condition = {
          StringLike = {
            "ses:FromAddress" = ["*@${var.domain}"]
          }
        }
      },
      {
        Sid    = "ReadSuppression"
        Effect = "Allow"
        Action = ["dynamodb:GetItem", "dynamodb:Query"]
        Resource = "arn:aws:dynamodb:${var.region}:${var.account_id}:table/${var.app_name}-email-suppression"
      }
    ]
  })
}

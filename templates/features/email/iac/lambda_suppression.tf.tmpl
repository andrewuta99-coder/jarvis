# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:email template:lambda_suppression@{{TEMPLATE_HASH}}

data "archive_file" "suppression" {
  type        = "zip"
  source_file = "${path.module}/../../../lambda/email_suppression/handler.py"
  output_path = "${path.module}/.lambda_suppression.zip"
}

resource "aws_iam_role" "suppression_lambda" {
  name = "${var.app_name}-email-suppression"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Action    = "sts:AssumeRole"
      Principal = { Service = "lambda.amazonaws.com" }
    }]
  })
}

resource "aws_iam_role_policy_attachment" "suppression_basic" {
  role       = aws_iam_role.suppression_lambda.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
}

resource "aws_iam_role_policy" "suppression_ddb" {
  role = aws_iam_role.suppression_lambda.id
  name = "ddb"
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Action = ["dynamodb:PutItem"]
      Resource = "arn:aws:dynamodb:${var.region}:${var.account_id}:table/${var.app_name}-email-suppression"
    }]
  })
}

resource "aws_cloudwatch_log_group" "suppression" {
  name              = "/aws/lambda/${var.app_name}-email-suppression"
  retention_in_days = 14
}

resource "aws_lambda_function" "suppression" {
  function_name    = "${var.app_name}-email-suppression"
  role             = aws_iam_role.suppression_lambda.arn
  handler          = "handler.lambda_handler"
  runtime          = "python3.11"
  filename         = data.archive_file.suppression.output_path
  source_code_hash = data.archive_file.suppression.output_base64sha256
  timeout          = 30
  memory_size      = 128

  environment {
    variables = {
      SUPPRESSION_TABLE = "${var.app_name}-email-suppression"
    }
  }

  depends_on = [aws_cloudwatch_log_group.suppression]
}

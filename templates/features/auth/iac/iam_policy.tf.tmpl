# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:auth template:iam_policy@{{TEMPLATE_HASH}}

variable "region"          { type = string, default = "{{REGION}}" }
variable "app_name"        { type = string, default = "{{APP_NAME}}" }
variable "account_id"      { type = string, default = "{{ACCOUNT_ID}}" }
variable "task_role_name"  { type = string, default = "{{APP_NAME}}-task" }

terraform {
  required_version = ">= 1.5.0"
  required_providers { aws = { source = "hashicorp/aws", version = "~> 5.0" } }
  backend "s3" {
    bucket         = "{{ACCOUNT_ID}}-tf-state-{{REGION}}"
    key            = "iam/auth/terraform.tfstate"
    region         = "{{REGION}}"
    encrypt        = true
    dynamodb_table = "terraform-state-lock"
  }
}

provider "aws" { region = var.region }

resource "aws_iam_role_policy" "auth" {
  name = "${var.app_name}-auth"
  role = var.task_role_name

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid    = "UsersAndSessions"
        Effect = "Allow"
        Action = [
          "dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem",
          "dynamodb:DeleteItem", "dynamodb:Query"
        ]
        Resource = [
          "arn:aws:dynamodb:${var.region}:${var.account_id}:table/${var.app_name}-users-v2",
          "arn:aws:dynamodb:${var.region}:${var.account_id}:table/${var.app_name}-users-v2/index/*",
          "arn:aws:dynamodb:${var.region}:${var.account_id}:table/${var.app_name}-sessions",
          "arn:aws:dynamodb:${var.region}:${var.account_id}:table/${var.app_name}-sessions/index/*",
          "arn:aws:dynamodb:${var.region}:${var.account_id}:table/${var.app_name}-signup-codes",
        ]
      },
      {
        Sid    = "JwtAndHmacSecrets"
        Effect = "Allow"
        Action = ["secretsmanager:GetSecretValue"]
        Resource = [
          "arn:aws:secretsmanager:${var.region}:${var.account_id}:secret:jarvis/${var.app_name}/jwt-*",
          "arn:aws:secretsmanager:${var.region}:${var.account_id}:secret:jarvis/${var.app_name}/hmac-signup-*"
        ]
      }
    ]
  })
}

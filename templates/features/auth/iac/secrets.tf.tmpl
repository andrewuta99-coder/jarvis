# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:auth template:secrets@{{TEMPLATE_HASH}}
#
# JWT signing secret + HMAC signup-code secret. Created with random
# initial values; rotate later via aws secretsmanager update-secret.

resource "random_password" "jwt" {
  length  = 64
  special = true
}

resource "random_password" "hmac_signup" {
  length  = 48
  special = false   # base64-safe
}

resource "aws_secretsmanager_secret" "jwt" {
  name        = "jarvis/${var.app_name}/jwt"
  description = "JWT signing key for ${var.app_name}"

  # Rotation supported but not auto-rotated at v0 — schedule manually if needed.
  recovery_window_in_days = 7
}

resource "aws_secretsmanager_secret_version" "jwt" {
  secret_id     = aws_secretsmanager_secret.jwt.id
  secret_string = jsonencode({ secret_key = random_password.jwt.result })

  lifecycle {
    ignore_changes = [secret_string]  # rotation updates this out-of-band
  }
}

resource "aws_secretsmanager_secret" "hmac_signup" {
  name        = "jarvis/${var.app_name}/hmac-signup"
  description = "HMAC key for signup verification codes"
  recovery_window_in_days = 7
}

resource "aws_secretsmanager_secret_version" "hmac_signup" {
  secret_id     = aws_secretsmanager_secret.hmac_signup.id
  secret_string = jsonencode({ secret_key = random_password.hmac_signup.result })

  lifecycle {
    ignore_changes = [secret_string]
  }
}

# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:gpu template:asg@{{TEMPLATE_HASH}}
#
# Scale-to-zero ASG. min=0, max=2, desired=0. ECS managed scaling drives
# desired_capacity up when GPU tasks are pending, back to 0 when idle.
# $0/hr when ASG is at 0.

resource "aws_autoscaling_group" "gpu" {
  name                = "${var.name_prefix}-asg"
  vpc_zone_identifier = data.terraform_remote_state.networking.outputs.private_subnet_ids

  min_size         = 0
  max_size         = var.max_size
  desired_capacity = 0   # ECS managed scaling owns this

  health_check_type         = "EC2"
  health_check_grace_period = 300
  default_cooldown          = 60

  # Spot only — interruption-tolerant by design (batch workloads w/ retries).
  mixed_instances_policy {
    instances_distribution {
      on_demand_base_capacity                  = 0
      on_demand_percentage_above_base_capacity = 0
      spot_allocation_strategy                 = "price-capacity-optimized"
    }
    launch_template {
      launch_template_specification {
        launch_template_id = aws_launch_template.gpu.id
        version            = "$Latest"
      }
      override { instance_type = var.instance_type }
    }
  }

  tag {
    key                 = "Name"
    value               = var.name_prefix
    propagate_at_launch = true
  }

  tag {
    key                 = "AmazonECSManaged"
    value               = ""
    propagate_at_launch = false   # required signal to ECS managed scaling
  }

  lifecycle {
    # ECS managed scaling owns desired_capacity. Terraform must not fight it.
    ignore_changes = [desired_capacity, mixed_instances_policy[0].launch_template[0].override]
  }
}

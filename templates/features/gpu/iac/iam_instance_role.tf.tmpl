# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:gpu template:iam_instance_role@{{TEMPLATE_HASH}}

resource "aws_iam_role" "gpu_instance" {
  name = "${var.name_prefix}-instance-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Action    = "sts:AssumeRole"
      Principal = { Service = "ec2.amazonaws.com" }
    }]
  })

  tags = local.common_tags
}

# Standard AWS-managed policy for ECS agent + ECR pulls
resource "aws_iam_role_policy_attachment" "gpu_instance_ecs" {
  role       = aws_iam_role.gpu_instance.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonEC2ContainerServiceforEC2Role"
}

# SSM Session Manager — for debugging without SSH key management
resource "aws_iam_role_policy_attachment" "gpu_instance_ssm" {
  role       = aws_iam_role.gpu_instance.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
}

resource "aws_iam_instance_profile" "gpu" {
  name = "${var.name_prefix}-instance-profile"
  role = aws_iam_role.gpu_instance.name
}

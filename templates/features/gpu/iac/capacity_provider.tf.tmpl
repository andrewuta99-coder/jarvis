# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:gpu template:capacity_provider@{{TEMPLATE_HASH}}
#
# IMPORTANT: this creates the capacity provider but does NOT add it to the
# cluster's capacity-providers list. That step is in scripts/cluster_association.sh
# and must be run ONCE manually after `terraform apply`. Reason: the
# cluster's existing FARGATE/FARGATE_SPOT registrations might be managed
# outside Terraform (typical with /jarvis-init's infra module); stepping
# on that list would break unrelated services.

resource "aws_ecs_capacity_provider" "gpu" {
  name = var.name_prefix

  auto_scaling_group_provider {
    auto_scaling_group_arn         = aws_autoscaling_group.gpu.arn
    managed_termination_protection = "DISABLED"

    managed_scaling {
      maximum_scaling_step_size = 1
      minimum_scaling_step_size = 1
      status                    = "ENABLED"
      target_capacity           = 100   # 100% utilization → scale up only when needed
    }
  }

  tags = local.common_tags
}

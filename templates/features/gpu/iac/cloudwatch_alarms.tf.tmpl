# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:gpu template:cloudwatch_alarms@{{TEMPLATE_HASH}}
#
# Notify when GPU tasks fail to schedule (would indicate Spot starvation
# in this AZ or insufficient quota). Send to the email feature if installed.

resource "aws_cloudwatch_metric_alarm" "no_capacity" {
  alarm_name          = "${var.name_prefix}-no-capacity"
  comparison_operator = "GreaterThanThreshold"
  evaluation_periods  = 2
  metric_name         = "PendingTaskCount"
  namespace           = "AWS/ECS"
  period              = 300
  statistic           = "Maximum"
  threshold           = 0
  treat_missing_data  = "notBreaching"

  dimensions = {
    ClusterName       = var.ecs_cluster_name
    CapacityProviderName = aws_ecs_capacity_provider.gpu.name
  }

  alarm_description = "GPU tasks pending for 10+ min — likely Spot starvation. Consider increasing max_size or switching instance_type."

  tags = local.common_tags
}

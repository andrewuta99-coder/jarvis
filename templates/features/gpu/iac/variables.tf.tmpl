# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:gpu template:variables@{{TEMPLATE_HASH}}

variable "region"        { type = string, default = "{{REGION}}" }
variable "app_name"      { type = string, default = "{{APP_NAME}}" }
variable "account_id"    { type = string, default = "{{ACCOUNT_ID}}" }
variable "name_prefix"   { type = string, default = "{{APP_NAME}}-gpu" }

variable "instance_type" {
  type = string
  default = "g5.2xlarge"
  description = "g5/g6 spot instance. g5.2xlarge is cheapest GPU on Spot; g6e.12xlarge for L40s workloads."
}

variable "max_size"      { type = number, default = 2 }

variable "ecs_cluster_name" {
  type = string
  default = "{{APP_NAME}}-cluster"
}

locals {
  common_tags = {
    Project = var.app_name, ManagedBy = "Jarvis", Feature = "gpu"
  }
}

terraform {
  required_version = ">= 1.5.0"
  required_providers { aws = { source = "hashicorp/aws", version = "~> 5.0" } }
  backend "s3" {
    bucket         = "{{ACCOUNT_ID}}-tf-state-{{REGION}}"
    key            = "gpu/terraform.tfstate"
    region         = "{{REGION}}"
    encrypt        = true
    dynamodb_table = "terraform-state-lock"
  }
}

provider "aws" {
  region = var.region
  default_tags { tags = local.common_tags }
}

data "terraform_remote_state" "networking" {
  backend = "s3"
  config = {
    bucket = "${var.account_id}-tf-state-${var.region}"
    key    = "networking/terraform.tfstate"
    region = var.region
  }
}

# AL2023 GPU AMI — REQUIRED. AL2 (glibc 2.26) fails uv sync for modern wheels.
data "aws_ssm_parameter" "ecs_gpu_ami" {
  name = "/aws/service/ecs/optimized-ami/amazon-linux-2023/gpu/recommended/image_id"
}

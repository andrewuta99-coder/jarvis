#!/usr/bin/env bash
# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:gpu file:cluster_association
#
# ONE-TIME post-apply step. Adds the GPU capacity provider to the ECS
# cluster's list without disturbing existing FARGATE/FARGATE_SPOT entries.
# Idempotent — safe to rerun.

set -euo pipefail

CLUSTER="{{APP_NAME}}-cluster"
GPU_PROVIDER="{{APP_NAME}}-gpu"
REGION="{{REGION}}"

echo "Reading existing capacity providers on $CLUSTER..."
EXISTING=$(aws ecs describe-clusters --clusters "$CLUSTER" --region "$REGION" \
  --query 'clusters[0].capacityProviders' --output json | jq -r '. | join(" ")')
echo "  current: $EXISTING"

# Merge: keep existing + add GPU provider if missing
NEW="$EXISTING"
if ! echo "$EXISTING" | grep -qw "$GPU_PROVIDER"; then
  NEW="$EXISTING $GPU_PROVIDER"
fi
echo "  new:     $NEW"

aws ecs put-cluster-capacity-providers \
  --cluster "$CLUSTER" \
  --region "$REGION" \
  --capacity-providers $NEW \
  --default-capacity-provider-strategy capacityProvider=FARGATE_SPOT,weight=1 \
  > /dev/null

echo "Done. Capacity provider $GPU_PROVIDER attached to $CLUSTER."
echo "Schedule GPU tasks with: capacity_provider_strategy.capacity_provider = \"$GPU_PROVIDER\""

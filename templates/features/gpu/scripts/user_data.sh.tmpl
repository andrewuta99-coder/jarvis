#!/bin/bash
# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:gpu file:user_data
#
# Runs on every GPU instance at boot. Three things matter:
#   1. Register with the ECS cluster
#   2. Enable Spot draining so interruption notices drain tasks gracefully
#   3. Wait for nvidia drivers BEFORE starting ECS agent (the GPU registration
#      race fix — without this, ECS schedules tasks before GPU resources
#      appear in stringSet, and tasks bounce back to PENDING)

set -euo pipefail

# 1. ECS config
cat >> /etc/ecs/ecs.config <<EOF
ECS_CLUSTER=${cluster_name}
ECS_ENABLE_SPOT_INSTANCE_DRAINING=true
ECS_CONTAINER_INSTANCE_TAGS={"Feature":"gpu","ManagedBy":"Jarvis"}
EOF

# 2. Wait for GPU drivers before starting the agent
echo "Waiting for nvidia-smi..."
until nvidia-smi >/dev/null 2>&1; do
  sleep 2
done
echo "nvidia-smi OK. GPU(s) detected:"
nvidia-smi --query-gpu=name --format=csv,noheader

# 3. Start ECS agent (now safe to register with GPU resources visible)
systemctl enable --now ecs

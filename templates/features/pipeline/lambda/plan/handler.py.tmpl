"""
Pipeline Plan handler — autonomous proposer.

When the inbox is empty, this Lambda generates new work for the pipeline
to do. Typical use: a long-running exploration loop where the orchestrator
keeps the system busy.

Pattern from CloudMortgage alpamayo_plan. v0.0.3 ships a stub that
generates a deterministic hello-world proposal. Replace with your own
proposer (Bedrock call, Gemini, etc.) when you adopt this feature.
"""
from __future__ import annotations

import json
import logging
import os
import uuid

import boto3

logger = logging.getLogger()
logger.setLevel(logging.INFO)

BUCKET       = os.environ["ARTIFACTS_BUCKET"]
INBOX_PREFIX = os.environ.get("INBOX_PREFIX", "pipeline-inbox/")

s3 = boto3.client("s3")


def lambda_handler(event, _context):
    # Stub proposer — replace with a Bedrock InvokeAgent call when adopting.
    proposal_id = f"prop-{uuid.uuid4().hex[:8]}"
    yaml_body = f"""# Auto-generated by pipeline_plan
proposal_id: {proposal_id}
created_by: pipeline-plan-bot
created_at: {os.environ.get('AWS_LAMBDA_LOG_GROUP_NAME', '')}
closed_loop_enabled: false
notes: |
  Replace pipeline_plan/handler.py with your own proposer to generate
  meaningful work. The default just emits a hello-world.
"""
    key = f"{INBOX_PREFIX}{proposal_id}.yaml"
    s3.put_object(Bucket=BUCKET, Key=key, Body=yaml_body.encode())
    logger.info("proposed", extra={"key": key})
    return {"proposed_key": key, "proposal_id": proposal_id}

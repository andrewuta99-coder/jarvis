# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:pipeline template:lambdas@{{TEMPLATE_HASH}}
#
# Five Lambdas for the Alpamayo pattern: claim, plan, gpu_ready, finalise, failure.

locals {
  lambda_names = ["claim", "plan", "gpu_ready", "finalise", "failure"]
  lambda_env = {
    ARTIFACTS_BUCKET     = aws_s3_bucket.inbox.id
    INBOX_PREFIX         = "pipeline-inbox/"
    ALLOWED_TIERS        = var.allowed_tiers
    SUBSCRIPTIONS_TABLE  = "${var.app_name}-subscriptions"
    SENDER_EMAIL         = "noreply@${var.app_name}.jarvis.app"
    NOTIFY_EMAIL         = var.notify_email
  }
}

# Package each Lambda from its handler.py
data "archive_file" "pipeline" {
  for_each    = toset(local.lambda_names)
  type        = "zip"
  source_file = "${path.module}/../../lambda/pipeline_${each.key}/handler.py"
  output_path = "${path.module}/.lambda_${each.key}.zip"
}

resource "aws_cloudwatch_log_group" "pipeline" {
  for_each          = toset(local.lambda_names)
  name              = "/aws/lambda/${var.app_name}-pipeline-${each.key}"
  retention_in_days = 14
}

resource "aws_lambda_function" "claim" {
  function_name    = "${var.app_name}-pipeline-claim"
  role             = aws_iam_role.lambda_pipeline.arn
  handler          = "handler.lambda_handler"
  runtime          = "python3.11"
  filename         = data.archive_file.pipeline["claim"].output_path
  source_code_hash = data.archive_file.pipeline["claim"].output_base64sha256
  timeout          = 60
  memory_size      = 256
  environment { variables = local.lambda_env }
  depends_on = [aws_cloudwatch_log_group.pipeline]
}

resource "aws_lambda_function" "plan" {
  function_name    = "${var.app_name}-pipeline-plan"
  role             = aws_iam_role.lambda_pipeline.arn
  handler          = "handler.lambda_handler"
  runtime          = "python3.11"
  filename         = data.archive_file.pipeline["plan"].output_path
  source_code_hash = data.archive_file.pipeline["plan"].output_base64sha256
  timeout          = 120
  memory_size      = 512
  environment { variables = local.lambda_env }
  depends_on = [aws_cloudwatch_log_group.pipeline]
}

resource "aws_lambda_function" "gpu_ready" {
  function_name    = "${var.app_name}-pipeline-gpu-ready"
  role             = aws_iam_role.lambda_pipeline.arn
  handler          = "handler.lambda_handler"
  runtime          = "python3.11"
  filename         = data.archive_file.pipeline["gpu_ready"].output_path
  source_code_hash = data.archive_file.pipeline["gpu_ready"].output_base64sha256
  timeout          = 30
  memory_size      = 256
  environment {
    variables = merge(local.lambda_env, {
      ECS_CLUSTER       = data.terraform_remote_state.infra.outputs.ecs_cluster_name
      CAPACITY_PROVIDER = "${var.app_name}-gpu"
    })
  }
  depends_on = [aws_cloudwatch_log_group.pipeline]
}

resource "aws_lambda_function" "finalise" {
  function_name    = "${var.app_name}-pipeline-finalise"
  role             = aws_iam_role.lambda_pipeline.arn
  handler          = "handler.lambda_handler"
  runtime          = "python3.11"
  filename         = data.archive_file.pipeline["finalise"].output_path
  source_code_hash = data.archive_file.pipeline["finalise"].output_base64sha256
  timeout          = 60
  memory_size      = 256
  environment { variables = local.lambda_env }
  depends_on = [aws_cloudwatch_log_group.pipeline]
}

resource "aws_lambda_function" "failure" {
  function_name    = "${var.app_name}-pipeline-failure"
  role             = aws_iam_role.lambda_pipeline.arn
  handler          = "handler.lambda_handler"
  runtime          = "python3.11"
  filename         = data.archive_file.pipeline["failure"].output_path
  source_code_hash = data.archive_file.pipeline["failure"].output_base64sha256
  timeout          = 60
  memory_size      = 256
  environment { variables = local.lambda_env }
  depends_on = [aws_cloudwatch_log_group.pipeline]
}

resource "aws_sfn_state_machine" "pipeline" {
  name     = "${var.app_name}-pipeline"
  role_arn = aws_iam_role.state_machine.arn

  definition = jsonencode({
    Comment = "AI/ML pipeline with S3 inbox, tier gate, and failure handler"
    StartAt = "ClaimInbox"
    States = {
      ClaimInbox = {
        Type     = "Task"
        Resource = aws_lambda_function.claim.arn
        Next     = "CheckEmpty"
        Catch = [{
          ErrorEquals = ["States.ALL"]
          Next        = "FailureHandler"
          ResultPath  = "$.error"
        }]
      }
      CheckEmpty = {
        Type = "Choice"
        Choices = [{
          Variable      = "$.empty"
          BooleanEquals = true
          Next          = "SucceedEmpty"

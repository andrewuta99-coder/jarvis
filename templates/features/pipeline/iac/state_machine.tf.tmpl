        Default = "GpuReady"
      }
      SucceedEmpty = { Type = "Succeed" }
      GpuReady = {
        Type     = "Task"
        Resource = aws_lambda_function.gpu_ready.arn
        Next     = "RunTask"
        Retry = [{
          ErrorEquals     = ["GpuNotReady"]
          IntervalSeconds = 30
          MaxAttempts     = 10
          BackoffRate     = 1.5
        }]
        Catch = [{
          ErrorEquals = ["States.ALL"]
          Next        = "FailureHandler"
          ResultPath  = "$.error"
        }]
      }
      RunTask = {
        # ECS task that does the heavy work. Targets the GPU capacity
        # provider when the gpu feature is installed, falls back to
        # FARGATE_SPOT otherwise. Subnets + SG pulled from networking
        # remote state — wired in v1.1.
        Type     = "Task"
        Resource = "arn:aws:states:::ecs:runTask.sync"
        Parameters = {
          Cluster        = data.terraform_remote_state.infra.outputs.ecs_cluster_arn
          TaskDefinition = data.terraform_remote_state.infra.outputs.pipeline_task_definition_arn != null ? data.terraform_remote_state.infra.outputs.pipeline_task_definition_arn : "${var.app_name}-pipeline-worker"
          CapacityProviderStrategy = [{
            CapacityProvider = "${var.app_name}-gpu"
            Weight           = 1
            Base             = 0
          }]
          NetworkConfiguration = {
            AwsvpcConfiguration = {
              Subnets        = data.terraform_remote_state.networking.outputs.private_subnet_ids
              SecurityGroups = [data.terraform_remote_state.networking.outputs.security_group_app_id]
              AssignPublicIp = "DISABLED"
            }
          }
        }
        Next    = "Finalise"
        Retry = [{
          ErrorEquals     = ["States.TaskFailed"]
          IntervalSeconds = 60
          MaxAttempts     = 2
        }]
        Catch = [{
          ErrorEquals = ["States.ALL"]
          Next        = "FailureHandler"
          ResultPath  = "$.error"
        }]
      }
      Finalise = {
        Type     = "Task"
        Resource = aws_lambda_function.finalise.arn
        End      = true
      }
      FailureHandler = {
        Type     = "Task"
        Resource = aws_lambda_function.failure.arn
        End      = true
      }
    }
  })

  tags = local.common_tags
}

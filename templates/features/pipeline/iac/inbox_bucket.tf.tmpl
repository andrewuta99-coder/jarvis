# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:pipeline template:inbox_bucket@{{TEMPLATE_HASH}}
#
# S3 inbox protocol:
#   pipeline-inbox/<file>.yaml       queued (top level)
#   pipeline-inbox/claimed/<run_id>/ in-flight
#   pipeline-inbox/done/<run_id>/    succeeded
#   pipeline-inbox/failed/<run_id>/  failed
#   pipeline-inbox/rejected/<run_id>/ tier-gated rejection (with rejection.json)
#   pipeline-inbox/STOP              kill switch (any file at this key = pause)

resource "aws_s3_bucket" "inbox" {
  bucket = local.inbox_bucket

  lifecycle {
    prevent_destroy = true
  }
}

resource "aws_s3_bucket_versioning" "inbox" {
  bucket = aws_s3_bucket.inbox.id
  versioning_configuration { status = "Enabled" }
}

resource "aws_s3_bucket_server_side_encryption_configuration" "inbox" {
  bucket = aws_s3_bucket.inbox.id
  rule { apply_server_side_encryption_by_default { sse_algorithm = "AES256" } }
}

resource "aws_s3_bucket_public_access_block" "inbox" {
  bucket                  = aws_s3_bucket.inbox.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

# Lifecycle: archive done/ proposals to Glacier after 30 days; failed/ kept
# at 365d for postmortem, then expired.
resource "aws_s3_bucket_lifecycle_configuration" "inbox" {
  bucket = aws_s3_bucket.inbox.id

  rule {
    id     = "archive-done"
    status = "Enabled"
    filter { prefix = "pipeline-inbox/done/" }
    transition { days = 30, storage_class = "GLACIER_IR" }
  }

  rule {
    id     = "expire-failed"
    status = "Enabled"
    filter { prefix = "pipeline-inbox/failed/" }
    expiration { days = 365 }
  }
}

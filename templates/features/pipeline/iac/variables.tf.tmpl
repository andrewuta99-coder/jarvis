# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:pipeline template:variables@{{TEMPLATE_HASH}}

variable "region"        { type = string, default = "{{REGION}}" }
variable "app_name"      { type = string, default = "{{APP_NAME}}" }
variable "account_id"    { type = string, default = "{{ACCOUNT_ID}}" }
variable "allowed_tiers" { type = string, default = "ultra,enterprise" }
variable "notify_email"  { type = string, default = "" }

locals {
  common_tags = { Project = var.app_name, ManagedBy = "Jarvis", Feature = "pipeline" }
  inbox_bucket = "${var.app_name}-pipeline-inbox-${var.account_id}"
}

terraform {
  required_version = ">= 1.5.0"
  required_providers { aws = { source = "hashicorp/aws", version = "~> 5.0" } }
  backend "s3" {
    bucket         = "{{ACCOUNT_ID}}-tf-state-{{REGION}}"
    key            = "pipeline/terraform.tfstate"
    region         = "{{REGION}}"
    encrypt        = true
    dynamodb_table = "terraform-state-lock"
  }
}

provider "aws" {
  region = var.region
  default_tags { tags = local.common_tags }
}

data "terraform_remote_state" "infra" {
  backend = "s3"
  config = {
    bucket = "${var.account_id}-tf-state-${var.region}"
    key    = "infra/terraform.tfstate"
    region = var.region
  }
}

data "terraform_remote_state" "networking" {
  backend = "s3"
  config = {
    bucket = "${var.account_id}-tf-state-${var.region}"
    key    = "networking/terraform.tfstate"
    region = var.region
  }
}

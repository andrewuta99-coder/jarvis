"""
Bedrock chat service.

Default path (this template): boto3 invoke_agent — simplest, AWS-native.
Optional advanced paths (v0.0.3 features):
  - add-rag-langchain: LangChain BedrockChat + Bedrock KB retriever
  - add-rag-langgraph: LangGraph state machine with Bedrock LLM nodes
"""
from __future__ import annotations

import logging
import os
import time
import uuid

import boto3

from core import dynamodb as ddb

logger = logging.getLogger(__name__)

REGION = os.environ.get("AWS_REGION", "{{REGION}}")
AGENT_ID = os.environ["BEDROCK_AGENT_ID"]
AGENT_ALIAS_ID = os.environ.get("BEDROCK_AGENT_ALIAS_ID", "TSTALIASID")
DEFAULT_MODEL = os.environ.get("DEFAULT_MODEL", "amazon.nova-lite-v1:0")

_runtime = None


def _agent_client():
    global _runtime
    if _runtime is None:
        _runtime = boto3.client("bedrock-agent-runtime", region_name=REGION)
    return _runtime


async def chat(*, tenant: str, user_id: str, message: str, thread_id: str | None) -> dict:
    """Invoke the Bedrock agent for one chat turn. Persists message history."""
    thread_id = thread_id or str(uuid.uuid4())
    session_id = f"{tenant}:{thread_id}"
    started = time.perf_counter()

    response_stream = _agent_client().invoke_agent(
        agentId=AGENT_ID,
        agentAliasId=AGENT_ALIAS_ID,
        sessionId=session_id,
        inputText=message,
        # enableTrace=True,   # turn on for debugging; costs more
    )

    # Aggregate the streamed completion
    text_chunks: list[str] = []
    citations: list[dict] = []
    for event in response_stream["completion"]:
        if "chunk" in event:
            chunk = event["chunk"]
            if "bytes" in chunk:
                text_chunks.append(chunk["bytes"].decode("utf-8"))
            for attr in chunk.get("attribution", {}).get("citations", []):
                for ref in attr.get("retrievedReferences", []):
                    citations.append({
                        "source": ref.get("location", {}).get("s3Location", {}).get("uri", ""),
                        "content": ref.get("content", {}).get("text", "")[:200],
                    })

    response_text = "".join(text_chunks)
    duration_ms = (time.perf_counter() - started) * 1000
    logger.info("chat_invoke", extra={
        "thread_id": thread_id,
        "tenant": tenant,
        "tokens_estimate": len(response_text) // 4,
        "duration_ms": round(duration_ms, 1),
        "citations": len(citations),
    })

    # Persist
    now = int(time.time())
    ddb.chat_threads_table().update_item(
        Key={"userId": user_id, "thread_id": thread_id},
        UpdateExpression="SET updated_at = :t, tenantId = if_not_exists(tenantId, :tn)",
        ExpressionAttributeValues={":t": now, ":tn": tenant},
    )
    ddb.chat_messages_table().put_item(Item={
        "thread_id": thread_id,
        "created_at": now * 1000,
        "role": "user",
        "content": message,
    })
    ddb.chat_messages_table().put_item(Item={
        "thread_id": thread_id,
        "created_at": now * 1000 + 1,
        "role": "assistant",
        "content": response_text,
        "model": DEFAULT_MODEL,
        "citations": citations,
    })

    return {
        "response": response_text,
        "thread_id": thread_id,
        "citations": citations,
        "model": DEFAULT_MODEL,
        "tokens_used": None,
    }


async def kb_query(*, tenant: str, query: str, top_k: int = 5):
    """Direct KB retrieval, no LLM. Useful for /chat/kb-query inspection."""
    kb_id = os.environ["BEDROCK_KB_ID"]
    resp = _agent_client().retrieve(
        knowledgeBaseId=kb_id,
        retrievalQuery={"text": query},
        retrievalConfiguration={"vectorSearchConfiguration": {"numberOfResults": top_k}},
    )
    return {
        "results": [
            {
                "content": r.get("content", {}).get("text", ""),
                "source": r.get("location", {}).get("s3Location", {}).get("uri", ""),
                "score": r.get("score", 0),
            }
            for r in resp.get("retrievalResults", [])
        ]
    }


async def list_threads(*, user_id: str) -> list[dict]:
    from boto3.dynamodb.conditions import Key
    resp = ddb.chat_threads_table().query(
        IndexName="userId-updated_at-index",
        KeyConditionExpression=Key("userId").eq(user_id),
        ScanIndexForward=False,
        Limit=50,
    )
    return resp.get("Items", [])


async def get_messages(*, user_id: str, thread_id: str) -> list[dict]:
    from boto3.dynamodb.conditions import Key
    resp = ddb.chat_messages_table().query(
        KeyConditionExpression=Key("thread_id").eq(thread_id),
        ScanIndexForward=True,
    )
    return resp.get("Items", [])

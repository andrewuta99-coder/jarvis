# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:ai template:bedrock_kb@{{TEMPLATE_HASH}}

resource "aws_bedrockagent_knowledge_base" "main" {
  name        = "${var.app_name}-kb"
  description = "Default knowledge base for ${var.app_name}"
  role_arn    = aws_iam_role.bedrock_agent.arn

  knowledge_base_configuration {
    type = "VECTOR"
    vector_knowledge_base_configuration {
      embedding_model_arn = "arn:aws:bedrock:${var.region}::foundation-model/amazon.titan-embed-text-v2:0"
    }
  }

  storage_configuration {
    type = "OPENSEARCH_SERVERLESS"
    opensearch_serverless_configuration {
      collection_arn    = aws_opensearchserverless_collection.ai.arn
      vector_index_name = "${var.app_name}-vector-index"
      field_mapping {
        vector_field   = "embedding"
        text_field     = "text"
        metadata_field = "metadata"
      }
    }
  }

  tags = local.common_tags
}

resource "aws_bedrockagent_data_source" "s3" {
  knowledge_base_id = aws_bedrockagent_knowledge_base.main.id
  name              = "${var.app_name}-s3-source"

  data_source_configuration {
    type = "S3"
    s3_configuration {
      bucket_arn         = aws_s3_bucket.kb_source.arn
      inclusion_prefixes = ["kb/"]
    }
  }
}

# Associate KB with agent
resource "aws_bedrockagent_agent_knowledge_base_association" "main" {
  agent_id             = aws_bedrockagent_agent.main.agent_id
  knowledge_base_id    = aws_bedrockagent_knowledge_base.main.id
  description          = "Default KB"
  knowledge_base_state = "ENABLED"
}

# Daily KB sync via EventBridge
resource "aws_cloudwatch_event_rule" "kb_daily_sync" {
  name                = "${var.app_name}-kb-daily-sync"
  description         = "Re-ingest KB source bucket daily"
  schedule_expression = "rate(1 day)"
}

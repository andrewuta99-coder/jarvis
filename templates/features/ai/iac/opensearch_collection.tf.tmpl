# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:ai template:opensearch_collection@{{TEMPLATE_HASH}}
#
# OpenSearch Serverless Vector collection. Min cost ~$50/mo (2 OCU index + 2 OCU search).

resource "aws_opensearchserverless_security_policy" "encryption" {
  name = "${var.app_name}-ai-encryption"
  type = "encryption"
  policy = jsonencode({
    Rules = [{
      Resource     = ["collection/${var.app_name}-ai"]
      ResourceType = "collection"
    }]
    AWSOwnedKey = true
  })
}

resource "aws_opensearchserverless_security_policy" "network" {
  name = "${var.app_name}-ai-network"
  type = "network"
  policy = jsonencode([{
    Description = "Private VPC only"
    Rules = [{
      Resource     = ["collection/${var.app_name}-ai"]
      ResourceType = "collection"
    }]
    AllowFromPublic = false
    SourceVPCEs     = []   # filled by reading networking remote state if needed
  }])
}

resource "aws_opensearchserverless_collection" "ai" {
  name = "${var.app_name}-ai"
  type = "VECTORSEARCH"
  description = "Bedrock KB vector store"

  depends_on = [
    aws_opensearchserverless_security_policy.encryption,
    aws_opensearchserverless_security_policy.network,
  ]

  tags = local.common_tags
}

# Data access policy — agent role + task role
resource "aws_opensearchserverless_access_policy" "ai" {
  name = "${var.app_name}-ai-access"
  type = "data"
  policy = jsonencode([{
    Description = "Agent + task role can read+write the AI collection"
    Rules = [
      {
        ResourceType = "collection"
        Resource     = ["collection/${var.app_name}-ai"]
        Permission   = ["aoss:*"]
      },
      {
        ResourceType = "index"
        Resource     = ["index/${var.app_name}-ai/*"]
        Permission   = ["aoss:*"]
      }
    ]
    Principal = [
      aws_iam_role.bedrock_agent.arn,
      data.terraform_remote_state.infra.outputs.task_role_arn,
    ]
  }])
}

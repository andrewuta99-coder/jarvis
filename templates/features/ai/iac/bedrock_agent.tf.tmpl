# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:ai template:bedrock_agent@{{TEMPLATE_HASH}}

resource "aws_bedrockagent_agent" "main" {
  agent_name              = "${var.app_name}-agent"
  agent_resource_role_arn = aws_iam_role.bedrock_agent.arn
  foundation_model        = var.default_model
  description             = "Default agent for ${var.app_name}"

  instruction = <<-EOT
You are a helpful AI assistant. Answer the user's question concisely and accurately.
When the knowledge base contains relevant information, cite it. When you do not
know the answer, say so — do not make up information.
  EOT

  idle_session_ttl_in_seconds = 1800   # 30 min session memory
  prepare_agent               = true
}

resource "aws_bedrockagent_agent_alias" "default" {
  agent_alias_name = "${var.app_name}-agent-default"
  agent_id         = aws_bedrockagent_agent.main.agent_id

  tags = local.common_tags
}

# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:ai template:iam_task_policy@{{TEMPLATE_HASH}}
#
# Task role policy for invoking Bedrock from the API.
# Includes aoss:BatchGetCollection — the 2026-01-16 fix that prevents the
# "Starting up AI knowledge base..." dead-loop.

variable "region"          { type = string, default = "{{REGION}}" }
variable "app_name"        { type = string, default = "{{APP_NAME}}" }
variable "account_id"      { type = string, default = "{{ACCOUNT_ID}}" }
variable "task_role_name"  { type = string, default = "{{APP_NAME}}-task" }

terraform {
  required_version = ">= 1.5.0"
  required_providers { aws = { source = "hashicorp/aws", version = "~> 5.0" } }
  backend "s3" {
    bucket         = "{{ACCOUNT_ID}}-tf-state-{{REGION}}"
    key            = "iam/ai/terraform.tfstate"
    region         = "{{REGION}}"
    encrypt        = true
    dynamodb_table = "terraform-state-lock"
  }
}

provider "aws" { region = var.region }

resource "aws_iam_role_policy" "ai_task" {
  name = "${var.app_name}-ai-task"
  role = var.task_role_name

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid    = "InvokeAgent"
        Effect = "Allow"
        Action = [
          "bedrock:InvokeAgent",
          "bedrock:InvokeAgentRuntime",
          "bedrock:Retrieve",
        ]
        Resource = [
          "arn:aws:bedrock:${var.region}:${var.account_id}:agent/*",
          "arn:aws:bedrock:${var.region}:${var.account_id}:agent-alias/*/*",
          "arn:aws:bedrock:${var.region}:${var.account_id}:knowledge-base/*",
        ]
      },
      {
        Sid    = "OpenSearchStatusCheck"
        Effect = "Allow"
        Action = [
          "aoss:BatchGetCollection",   # THE 2026-01-16 fix
          "aoss:ListCollections",
        ]
        Resource = "*"
      },
      {
        Sid    = "ChatTables"
        Effect = "Allow"
        Action = [
          "dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem",
          "dynamodb:Query",
        ]
        Resource = [
          "arn:aws:dynamodb:${var.region}:${var.account_id}:table/${var.app_name}-chat-threads",
          "arn:aws:dynamodb:${var.region}:${var.account_id}:table/${var.app_name}-chat-threads/index/*",
          "arn:aws:dynamodb:${var.region}:${var.account_id}:table/${var.app_name}-chat-messages",
        ]
      }
    ]
  })
}

# Generated by Jarvis v{{JARVIS_VERSION}} on {{ISO_DATE}}
# feature:ai template:iam_agent_role@{{TEMPLATE_HASH}}
#
# The 2026-01-16 multi-model fix — wildcards across Nova AND Claude families.
# The user can swap default_model freely in code without redeploying IAM.

resource "aws_iam_role" "bedrock_agent" {
  name = "${var.app_name}-bedrock-agent"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Action    = "sts:AssumeRole"
      Principal = { Service = "bedrock.amazonaws.com" }
    }]
  })
}

resource "aws_iam_role_policy" "bedrock_agent" {
  name = "${var.app_name}-bedrock-agent"
  role = aws_iam_role.bedrock_agent.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid    = "InvokeAnyFoundationModel"
        Effect = "Allow"
        Action = ["bedrock:InvokeModel"]
        Resource = [
          "arn:aws:bedrock:${var.region}::foundation-model/amazon.nova-*",
          "arn:aws:bedrock:${var.region}::foundation-model/amazon.titan-embed-*",
          "arn:aws:bedrock:${var.region}::foundation-model/anthropic.claude-*",
        ]
      },
      {
        Sid    = "QueryKnowledgeBase"
        Effect = "Allow"
        Action = ["bedrock:Retrieve", "bedrock:RetrieveAndGenerate"]
        Resource = "arn:aws:bedrock:${var.region}:${var.account_id}:knowledge-base/*"
      },
      {
        Sid    = "ReadKBSourceBucket"
        Effect = "Allow"
        Action = ["s3:GetObject", "s3:ListBucket"]
        Resource = [
          aws_s3_bucket.kb_source.arn,
          "${aws_s3_bucket.kb_source.arn}/*",
        ]
      },
      {
        Sid    = "OpenSearchServerless"
        Effect = "Allow"
        Action = ["aoss:APIAccessAll", "aoss:DashboardsAccessAll"]
        Resource = aws_opensearchserverless_collection.ai.arn
      }
    ]
  })
}

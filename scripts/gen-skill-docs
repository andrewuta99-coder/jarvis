#!/usr/bin/env python3
"""
gen-skill-docs — keep SKILL.md descriptions in sync with manifest.yaml.

Lifted (in spirit) from gstack's gen-skill-docs pattern. For every feature
template, reads its manifest.yaml and updates the corresponding
agents/<name>/SKILL.md description block + the matching add-<name>/SKILL.md
where applicable.

Idempotent. Run before commit to keep skill descriptions accurate.

Usage:
    scripts/gen-skill-docs              # apply
    scripts/gen-skill-docs --dry-run    # report only
    scripts/gen-skill-docs --check      # exit 1 if any file would change (CI mode)
"""
from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
FEATURES_DIR = ROOT / "templates" / "features"
AGENTS_DIR = ROOT / "agents"


def manifest_description(manifest_path: Path) -> str | None:
    """Extract the `description:` block (multi-line "|" form) from a manifest."""
    if not manifest_path.exists():
        return None
    lines = manifest_path.read_text().splitlines()
    desc: list[str] = []
    in_desc = False
    base_indent = 0
    for line in lines:
        if line.startswith("description:"):
            tail = line.split(":", 1)[1].strip()
            if tail and tail != "|":
                return tail
            in_desc = True
            continue
        if in_desc:
            if not line.strip():
                desc.append("")
                continue
            indent = len(line) - len(line.lstrip())
            if indent == 0:
                break
            if base_indent == 0:
                base_indent = indent
            desc.append(line[base_indent:])
    return "\n".join(desc).rstrip() or None


def update_skill_description(skill_path: Path, new_description: str, *, dry_run: bool = False) -> bool:
    """Replace the `description: |` block in a SKILL.md frontmatter.
    Returns True if the file was (or would be) changed.
    """
    if not skill_path.exists():
        return False
    text = skill_path.read_text()
    # Match the frontmatter description block — `description: |` then indented lines.
    pattern = re.compile(
        r"(description:\s*\|\s*\n)((?:^[ \t]+.*\n)+)",
        re.MULTILINE,
    )
    indented = "\n".join("  " + line if line else "" for line in new_description.splitlines())
    new_block = f"description: |\n{indented}\n"
    new_text, count = pattern.subn(new_block, text, count=1)
    if count == 0 or new_text == text:
        return False
    if not dry_run:
        skill_path.write_text(new_text)
    return True


def main() -> int:
    parser = argparse.ArgumentParser(description="Sync SKILL.md descriptions from manifests")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--check", action="store_true", help="Exit 1 if any file is out of date")
    args = parser.parse_args()

    changes: list[str] = []

    for feature_dir in sorted(FEATURES_DIR.iterdir()):
        if not feature_dir.is_dir():
            continue
        manifest = feature_dir / "manifest.yaml"
        description = manifest_description(manifest)
        if not description:
            continue

        # Sync to the specialist agent SKILL.md if present
        for candidate in [
            AGENTS_DIR / feature_dir.name / "SKILL.md",
            ROOT / f"add-{feature_dir.name}" / "SKILL.md",
        ]:
            if update_skill_description(candidate, description, dry_run=args.check or args.dry_run):
                changes.append(str(candidate.relative_to(ROOT)))

    if not changes:
        print("All SKILL.md descriptions are in sync with manifests.")
        return 0

    print(f"{len(changes)} SKILL.md file(s) {'would be' if args.dry_run or args.check else ''} updated:")
    for c in changes:
        print(f"  - {c}")

    if args.check:
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())

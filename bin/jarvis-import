#!/usr/bin/env python3
"""
jarvis-import — bulk import an existing AWS account into Terraform-managed
state. The "brownfield adoption" tool.

Scans your account for resources matching common Jarvis patterns
(DynamoDB tables, S3 buckets, ECS clusters/services, Lambda, Secrets,
ECR repos, IAM roles), generates Terraform import blocks for each,
applies prevent_destroy automatically to data-bearing resources.

NEVER applies. Always produces .tf files + import blocks the user
runs themselves.

Usage:
    jarvis-import --target-dir /path/to/app --region us-east-1
    jarvis-import --target-dir . --include 'cloudmortgage-*'
    jarvis-import --target-dir . --exclude 'test-*' --dry-run
"""
from __future__ import annotations

import argparse
import fnmatch
import json
import sys
from pathlib import Path

try:
    import boto3
    from botocore.exceptions import BotoCoreError, ClientError
except ImportError:
    print("boto3 required. pip install boto3", file=sys.stderr)
    sys.exit(1)


def matches(name: str, include: list[str] | None, exclude: list[str] | None) -> bool:
    if include and not any(fnmatch.fnmatch(name, pat) for pat in include):
        return False
    if exclude and any(fnmatch.fnmatch(name, pat) for pat in exclude):
        return False
    return True


def discover(region: str, include: list[str] | None, exclude: list[str] | None) -> dict:
    found = {"dynamodb": [], "s3": [], "ecs_clusters": [], "lambdas": [], "secrets": [], "ecr_repos": []}

    ddb = boto3.client("dynamodb", region_name=region)
    try:
        for t in ddb.list_tables()["TableNames"]:
            if matches(t, include, exclude):
                found["dynamodb"].append(t)
    except ClientError as e:
        print(f"  warn: dynamodb scan failed: {e}", file=sys.stderr)

    s3 = boto3.client("s3")
    try:
        for b in s3.list_buckets()["Buckets"]:
            if matches(b["Name"], include, exclude):
                found["s3"].append(b["Name"])
    except ClientError as e:
        print(f"  warn: s3 scan failed: {e}", file=sys.stderr)

    ecs = boto3.client("ecs", region_name=region)
    try:
        clusters = ecs.list_clusters()["clusterArns"]
        for arn in clusters:
            name = arn.rsplit("/", 1)[-1]
            if matches(name, include, exclude):
                found["ecs_clusters"].append(name)
    except ClientError as e:
        print(f"  warn: ecs scan failed: {e}", file=sys.stderr)

    lam = boto3.client("lambda", region_name=region)
    try:
        for f in lam.list_functions()["Functions"]:
            if matches(f["FunctionName"], include, exclude):
                found["lambdas"].append(f["FunctionName"])
    except ClientError as e:
        print(f"  warn: lambda scan failed: {e}", file=sys.stderr)

    sm = boto3.client("secretsmanager", region_name=region)
    try:
        paginator = sm.get_paginator("list_secrets")
        for page in paginator.paginate():
            for s in page.get("SecretList", []):
                if matches(s["Name"], include, exclude):
                    found["secrets"].append(s["Name"])
    except ClientError as e:
        print(f"  warn: secrets scan failed: {e}", file=sys.stderr)

    ecr = boto3.client("ecr", region_name=region)
    try:
        for r in ecr.describe_repositories()["repositories"]:
            if matches(r["repositoryName"], include, exclude):
                found["ecr_repos"].append(r["repositoryName"])
    except ClientError as e:
        print(f"  warn: ecr scan failed: {e}", file=sys.stderr)

    return found


def generate_terraform(found: dict, target_dir: Path) -> list[Path]:
    """Produce iac/import/*.tf files with import blocks + resource declarations."""
    out_dir = target_dir / "iac" / "import"
    out_dir.mkdir(parents=True, exist_ok=True)
    written: list[Path] = []

    if found["dynamodb"]:
        path = out_dir / "dynamodb.tf"
        lines = [
            "# Generated by jarvis-import. Imports existing DynamoDB tables into",
            "# Terraform state. Every table gets prevent_destroy + PITR + deletion_protection.",
            "# Run: cd iac/import && terraform init && terraform plan",
            "",
        ]
        for name in found["dynamodb"]:
            safe = name.replace("-", "_").replace(".", "_")
            lines += [
                f'import {{',
                f'  to = aws_dynamodb_table.{safe}',
                f'  id = "{name}"',
                f'}}',
                f'',
                f'resource "aws_dynamodb_table" "{safe}" {{',
                f'  name         = "{name}"',
                f'  billing_mode = "PAY_PER_REQUEST"',
                f'  hash_key     = "id"   # adjust after first terraform plan if needed',
                f'',
                f'  attribute {{',
                f'    name = "id"',
                f'    type = "S"',
                f'  }}',
                f'',
                f'  point_in_time_recovery {{ enabled = true }}',
                f'  deletion_protection_enabled = true',
                f'  server_side_encryption {{ enabled = true }}',
                f'',
                f'  lifecycle {{',
                f'    prevent_destroy = true',
                f'    ignore_changes  = [attribute, global_secondary_index, hash_key, range_key]',
                f'  }}',
                f'}}',
                f'',
            ]
        path.write_text("\n".join(lines))
        written.append(path)

    if found["s3"]:
        path = out_dir / "s3.tf"
        lines = [
            "# Generated by jarvis-import. S3 buckets adopted into Terraform.",
            "",
        ]
        for name in found["s3"]:
            safe = name.replace("-", "_").replace(".", "_")
            lines += [
                f'import {{',
                f'  to = aws_s3_bucket.{safe}',
                f'  id = "{name}"',
                f'}}',
                f'',
                f'resource "aws_s3_bucket" "{safe}" {{',
                f'  bucket = "{name}"',
                f'  lifecycle {{',
                f'    prevent_destroy = true   # remove if this bucket is disposable',
                f'  }}',
                f'}}',
                f'',
            ]
        path.write_text("\n".join(lines))
        written.append(path)

    if found["ecr_repos"]:
        path = out_dir / "ecr.tf"
        lines = ["# Generated by jarvis-import. ECR repositories adopted.", ""]
        for name in found["ecr_repos"]:
            safe = name.replace("-", "_").replace(".", "_")
            lines += [
                f'import {{ to = aws_ecr_repository.{safe}, id = "{name}" }}',
                f'',
                f'resource "aws_ecr_repository" "{safe}" {{',
                f'  name = "{name}"',
                f'}}',
                f'',
            ]
        path.write_text("\n".join(lines))
        written.append(path)

    # Backend + provider
    backend_path = out_dir / "backend.tf"
    backend_path.write_text("""\
terraform {
  required_version = ">= 1.5.0"
  required_providers { aws = { source = "hashicorp/aws", version = "~> 5.0" } }
}
provider "aws" { region = var.region }
variable "region" { type = string, default = "us-east-1" }
""")
    written.append(backend_path)

    return written


def main() -> int:
    parser = argparse.ArgumentParser(description="Bulk-import existing AWS into Terraform")
    parser.add_argument("--target-dir", required=True, type=Path)
    parser.add_argument("--region", default="us-east-1")
    parser.add_argument("--include", nargs="*", help="Resource name patterns to include (fnmatch)")
    parser.add_argument("--exclude", nargs="*", help="Resource name patterns to exclude (fnmatch)")
    parser.add_argument("--dry-run", action="store_true", help="List what would be imported, don't write files")
    args = parser.parse_args()

    print(f"Scanning AWS account in {args.region}...")
    found = discover(args.region, args.include, args.exclude)
    total = sum(len(v) for v in found.values())

    print(f"\nDiscovered {total} resource(s):")
    for kind, names in found.items():
        if names:
            print(f"  {kind:18}  {len(names):3}  e.g., {names[0]}")

    if total == 0:
        print("\nNothing to import. (try --include with fewer filters)")
        return 0

    if args.dry_run:
        print("\nDry-run. No files written.")
        return 0

    print(f"\nWriting Terraform import files to {args.target_dir}/iac/import/")
    written = generate_terraform(found, args.target_dir)
    for p in written:
        print(f"  wrote {p.relative_to(args.target_dir)}")

    print("\nNext steps:")
    print("  cd iac/import")
    print("  terraform init")
    print("  terraform plan      # review the import plan carefully")
    print("  terraform apply     # commits the import — no resources changed in AWS")
    print("\nIf any resource shows 'must be replaced' in the plan, do NOT apply.")
    print("Adjust the .tf file (hash_key, attributes, etc.) to match the real resource.")
    return 0


if __name__ == "__main__":
    sys.exit(main())

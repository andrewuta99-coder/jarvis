#!/usr/bin/env python3
"""
jarvis-eject-doc — generates ARCHITECTURE.md from .jarvis/profile.json.

Called by /jarvis-eject before removing Jarvis state. Captures everything
the team would need to continue maintaining the stack without Jarvis
installed.

Usage:
    jarvis-eject-doc --target-dir /path/to/app
"""
from __future__ import annotations

import argparse
import datetime as dt
import json
import sys
from pathlib import Path


TEMPLATE = """# {app_name} — Architecture

Generated by Jarvis on eject, {date}. Safe to edit.

This document was produced by `jarvis-eject` so the team can continue
maintaining the stack without Jarvis installed. Everything below is yours.

## Stack at-a-glance

- **Frontend**: {frontend}
- **Backend**: {backend}
- **Region**: {region}
- **AWS Account**: {account_id}
- **Domain**: {domain}

## Features installed

{features_table}

## AWS resource inventory

The Terraform under `iac/` is the source of truth. Quick map:

| Module | What it manages |
|---|---|
| iac/networking/ | VPC, subnets (3 private + 2 public), ALB with HTTPS, security groups, VPC endpoints |
| iac/infra/      | ECS cluster (Fargate Spot default), ECR, base IAM roles, GitHub OIDC, Terraform state backend |
| iac/data/       | DynamoDB tables (every table has PITR + deletion protection + prevent_destroy) |
| iac/ecs/        | API task definition + service |
| iac/ai/         | Bedrock agent + Knowledge Base + OpenSearch Serverless |
| iac/email/      | SES sender + bounce/complaint Lambda |
| iac/payments/   | Stripe Secrets Manager entries |
| iac/deploy/     | Amplify Hosting + GitHub Actions OIDC |

(Modules you didn't install above are skipped.)

## Deploy

CI is in `.github/workflows/deploy.yml`. Push to `main` triggers:
1. Backend: docker buildx + ECR push + ECS rolling deploy + auto-rollback on healthcheck failure
2. Frontend: Amplify Hosting auto-builds + deploys from the same commit

Local fallback: `./scripts/deploy.sh`.

## Local development

```bash
# Backend
cd backend && pip install -r requirements-dev.txt
uvicorn main:app --reload --port 8000

# Frontend
cd frontend && npm install --legacy-peer-deps
npm start                   # http://localhost:3000
```

## Production gotchas baked into this stack

These defaults are not standard AWS — they were installed by Jarvis based
on real production incidents. **Keep them.**

- DynamoDB tables have `prevent_destroy` + PITR + `deletion_protection_enabled`.
  Don't remove without a real reason. The 2026-01-18 Terraform incident at
  CloudMortgage destroyed tables when these were missing.
- VPC endpoints for SES + Bedrock + AOSS are required from private subnets.
  Without them, your tasks see silent connection timeouts. Don't replace
  with NAT Gateway without re-budgeting (~$130/mo vs $0).
- Bedrock agent IAM uses **multi-model wildcards** (Nova + Claude families).
  You can swap `DEFAULT_MODEL` env var without redeploying IAM.
- Step Functions workers have **SIGTERM handlers** + 1h hard timeout
  (`backend/core/signals.py`). The 2026-12-22 orphan-task incident is
  prevented by these. Don't remove.
- Stripe webhook has the **idempotency middleware** (`backend/payments/
  idempotency.py`). The 2026-01-11 double-charge incident is prevented.
- Signup verification uses **HMAC-SHA256 + constant-time compare**. The
  SHA256-only path is insecure — do not revert.

## Cost shape

| Component | Idle | At 1k users |
|---|---|---|
| VPC endpoints (interface) | ~$130/mo | ~$130/mo |
| ECS Fargate Spot | ~$5/mo | ~$20/mo |
| DynamoDB pay-per-request | $0 | ~$2/mo |
| OpenSearch Serverless (KB) | ~$50/mo | ~$50/mo |
| SES | $0 (62k free) | ~$1/mo |
| CloudWatch logs | ~$1/mo | ~$5/mo |
| Secrets Manager | ~$1.20/mo | ~$1.20/mo |
| **Total** | **~$190/mo** | **~$210/mo** |

(Excludes Bedrock invocation, Stripe fees.)

## Where to learn more

This stack was bootstrapped by [Jarvis](https://github.com/andrewuta99-coder/jarvis).
You can re-install Jarvis at any time to continue using it, or maintain the
stack manually. The Terraform is standard and self-contained.

If you want to keep new features in sync with upstream Jarvis improvements
(without re-adopting the tool), watch the Jarvis CHANGELOG and pull patches
selectively.
"""


def main() -> int:
    parser = argparse.ArgumentParser(description="Generate ARCHITECTURE.md from .jarvis/profile.json")
    parser.add_argument("--target-dir", required=True, type=Path)
    args = parser.parse_args()

    profile_path = args.target_dir / ".jarvis" / "profile.json"
    if not profile_path.exists():
        print(f"No profile at {profile_path}", file=sys.stderr)
        return 1

    profile = json.loads(profile_path.read_text())
    features = profile.get("features") or {}

    rows = []
    for name, ver in sorted(features.items() if isinstance(features, dict) else [(f, "0.0.1") for f in features]):
        rows.append(f"| {name} | {ver} |")
    features_table = "| Feature | Version |\n|---|---|\n" + ("\n".join(rows) if rows else "| — | — |")

    body = TEMPLATE.format(
        app_name=profile.get("app_name", "your-app"),
        date=dt.date.today().isoformat(),
        frontend=profile.get("frontend", "—"),
        backend=profile.get("backend", "—"),
        region=profile.get("region", "us-east-1"),
        account_id=profile.get("account", "—"),
        domain=profile.get("domain") or f"{profile.get('app_name', 'app')}.jarvis.app",
        features_table=features_table,
    )

    out_path = args.target_dir / "ARCHITECTURE.md"
    out_path.write_text(body)
    print(f"Wrote {out_path} ({len(body)} bytes)")
    return 0


if __name__ == "__main__":
    sys.exit(main())

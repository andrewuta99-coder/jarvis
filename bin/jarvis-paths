#!/usr/bin/env bash
# jarvis-paths — emit shell exports for Jarvis-managed paths.
# Usage: eval "$(jarvis-paths)"

JARVIS_DIR="$(cd "$(dirname "$0")/.." && pwd)"
JARVIS_HOME="${JARVIS_HOME:-$HOME/.jarvis}"

echo "export JARVIS_DIR=\"$JARVIS_DIR\""
echo "export JARVIS_HOME=\"$JARVIS_HOME\""
echo "export JARVIS_VERSION=\"$(cat "$JARVIS_DIR/VERSION" 2>/dev/null || echo 0.0.0)\""

#!/usr/bin/env python3
"""
jarvis-orchestrate — run a Jarvis constellation end-to-end.

Reads .jarvis/CONSTELLATION.json, runs each phase's features in parallel
(when phase.parallel == true) or sequentially. Each feature is rendered via
jarvis-render. After each phase, agent-outputs/*.json are merged into the
context so later phases can reference them.

This is the deterministic execution path. The Claude orchestrator in
init/SKILL.md is the conversational driver that builds the context and
constellation; jarvis-orchestrate is what actually writes files.

Usage:
    jarvis-orchestrate --target-dir /path/to/app
        # uses .jarvis/CONSTELLATION.json and .jarvis/CONTEXT.json
"""
from __future__ import annotations

import argparse
import concurrent.futures
import json
import subprocess
import sys
from pathlib import Path


def run_feature(*, jarvis_dir: Path, feature: str, context_path: Path, target_dir: Path) -> tuple[str, int, str]:
    """Invoke jarvis-render for one feature. Returns (feature, exit_code, stderr)."""
    cmd = [
        sys.executable,
        str(jarvis_dir / "bin" / "jarvis-render"),
        "--feature", feature,
        "--context", str(context_path),
        "--target-dir", str(target_dir),
    ]
    proc = subprocess.run(cmd, capture_output=True, text=True)
    return (feature, proc.returncode, proc.stderr + proc.stdout)


def merge_outputs(target_dir: Path, context: dict) -> dict:
    """After a phase, read .jarvis/agent-outputs/*.json and merge into context."""
    outputs_dir = target_dir / ".jarvis" / "agent-outputs"
    if not outputs_dir.exists():
        return context
    for out_file in outputs_dir.glob("*.json"):
        try:
            data = json.loads(out_file.read_text())
            for k, v in data.items():
                context[k.upper()] = v
        except Exception as exc:
            print(f"  WARN: could not read {out_file}: {exc}", file=sys.stderr)
    return context


def main() -> int:
    parser = argparse.ArgumentParser(description="Run a Jarvis constellation")
    parser.add_argument("--target-dir", required=True, type=Path)
    parser.add_argument("--jarvis-dir", type=Path,
                        default=Path(__file__).parent.parent,
                        help="Jarvis installation root")
    parser.add_argument("--max-parallel", type=int, default=4)
    args = parser.parse_args()

    constellation_path = args.target_dir / ".jarvis" / "CONSTELLATION.json"
    context_path = args.target_dir / ".jarvis" / "CONTEXT.json"

    if not constellation_path.exists():
        print(f"No constellation at {constellation_path}", file=sys.stderr)
        print("Run /jarvis-init first to produce one.", file=sys.stderr)
        return 1

    constellation = json.loads(constellation_path.read_text())
    context = json.loads(context_path.read_text()) if context_path.exists() else {}

    print(f"Orchestrating: {constellation_path}")
    print(f"  phases: {len(constellation.get('phases', []))}")

    phase_durations: dict[str, float] = {}

    for i, phase in enumerate(constellation.get("phases", []), 1):
        phase_id = phase.get("id", f"phase-{i}")
        parallel = phase.get("parallel", False)
        agents = phase.get("agents", [])
        agent_names = [a["agent"] for a in agents]

        print(f"\n--- Phase {i}: {phase_id} ({'parallel' if parallel else 'sequential'}) ---")
        print(f"  features: {agent_names}")

        import time
        started = time.perf_counter()

        if parallel:
            with concurrent.futures.ThreadPoolExecutor(max_workers=args.max_parallel) as pool:
                futures = [
                    pool.submit(run_feature,
                                jarvis_dir=args.jarvis_dir,
                                feature=name,
                                context_path=context_path,
                                target_dir=args.target_dir)
                    for name in agent_names
                ]
                failures = []
                for fut in concurrent.futures.as_completed(futures):
                    feature, rc, out = fut.result()
                    print(f"  [{feature}] {'OK' if rc == 0 else 'FAIL'}")
                    if rc != 0:
                        failures.append((feature, out))
                if failures:
                    for feature, out in failures:
                        print(f"\n--- {feature} failure ---", file=sys.stderr)
                        print(out, file=sys.stderr)
                    return 1
        else:
            for name in agent_names:
                feature, rc, out = run_feature(
                    jarvis_dir=args.jarvis_dir,
                    feature=name,
                    context_path=context_path,
                    target_dir=args.target_dir,
                )
                print(f"  [{feature}] {'OK' if rc == 0 else 'FAIL'}")
                if rc != 0:
                    print(out, file=sys.stderr)
                    return 1

        phase_durations[phase_id] = time.perf_counter() - started
        print(f"  phase {phase_id} done in {phase_durations[phase_id]:.1f}s")

        # Re-read context after each phase (agents may have written agent-outputs)
        context = merge_outputs(args.target_dir, context)
        context_path.write_text(json.dumps(context, indent=2))

    print("\n=== Orchestration complete ===")
    for pid, d in phase_durations.items():
        print(f"  {pid}: {d:.1f}s")
    print(f"  total: {sum(phase_durations.values()):.1f}s")

    return 0


if __name__ == "__main__":
    sys.exit(main())
